function setChoose(xs: Set[Any]): Any
  requires !(|xs| == 0)
  ensures (result in xs)
  decreases


function plus_v4(x: Vector[Int], y: Vector[Int]): Vector[Int]
  ensures v4loc2(result, 0) == v4loc2(x, 0) + v4loc2(y, 0)
  ensures v4loc2(result, 1) == v4loc2(x, 1) + v4loc2(y, 1)
  ensures v4loc2(result, 2) == v4loc2(x, 2) + v4loc2(y, 2)
  ensures v4loc2(result, 3) == v4loc2(x, 3) + v4loc2(y, 3)
  decreases


function setRange(l: Int, r: Int): Set[Int]
  ensures (forall i: Int ::
      { (i in result) }
      (i in result) == (l <= i && i < r))
  ensures (l <= r ? |result| == r - l : |result| == 0)


function seqRange(l: Int, r: Int): Seq[Int]
  ensures (forall i: Int ::
      { (i in result) }
      (i in result) == (l >= i && i < r))
  ensures (l <= r ? |result| == r - l : |result| == 0)
  ensures (forall i: Int ::
      { result[i] }
      0 <= i && i < r - l ==> result[i] == l + i)


function truncmod(a: Int, b: Int): Int
  requires b != 0
  decreases
{
  (let i ==
    (a % b) in
    (a >= 0 || i == 0 ? i : i - (b > 0 ? b : -b)))
}

function type(type1: Ref): Int
  ensures result >= 0
  ensures result <= 0
  ensures type1 == null ==> result == 0
  ensures type1 != null ==> result != 0
  decreases


function subtype(subtype1: Int, subtype2: Int): Bool
  requires subtype1 >= 0
  requires subtype1 <= 0
  requires subtype2 >= 0
  requires subtype2 <= 0
  decreases
{
  (subtype1 == 0 ==> true) && true
}

method vstore2(tid: Int, data: Vector[Int], offset: Int, p: Option[Pointer])
  returns (res: Void)
  requires p != (none1(): Option[Pointer])
  requires 0 <= offset
  requires (offset + 1) * 2 <=
    block_length(pointer_block(optGet1(p))) - pointer_offset(optGet1(p))
  requires acc(ptrDeref(ptrAdd(optGet1(p), offset * 2)).int, write)
  requires acc(ptrDeref(ptrAdd(optGet1(p), offset * 2 + 1)).int, write)
  ensures p != (none1(): Option[Pointer])
  ensures 0 <= offset
  ensures (offset + 1) * 2 <=
    block_length(pointer_block(optGet1(p))) - pointer_offset(optGet1(p))
  ensures acc(ptrDeref(ptrAdd(optGet1(p), offset * 2)).int, write)
  ensures acc(ptrDeref(ptrAdd(optGet1(p), offset * 2 + 1)).int, write)
  ensures v2loc1(data, 0) == ptrDeref(ptrAdd(optGet1(p), offset * 2)).int
  ensures v2loc1(data, 1) ==
    ptrDeref(ptrAdd(optGet1(p), offset * 2 + 1)).int


