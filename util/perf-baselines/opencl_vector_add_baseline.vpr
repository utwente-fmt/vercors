function anyAs(t: Any): Any
  decreases


function asAny(t: Any): Any
  ensures anyAs(result) == t
  decreases


function v4loc(a: Vector[Any], i: Int): Any
  requires 0 <= i
  requires i < 4
  decreases
{
  (vector_loc(a, i): Any)
}

function ptrDeref(p: Pointer): Ref
  decreases
{
  loc(pointer_block(p), pointer_offset(p))
}

function ptrAdd(p: Pointer, offset: Int): Pointer
  requires 0 <= pointer_offset(p) + offset
  requires pointer_offset(p) + offset < block_length(pointer_block(p))
  ensures offset == 0 ==> result == p
  ensures pointer_offset(result) == pointer_offset(p) + offset
  ensures pointer_block(result) == pointer_block(p)
  decreases


function ptrAddAxiom(): Bool
  ensures [(forall p: Pointer, offset: Int, i: Int ::
      { ptrAdd(ptrAdd(p, offset), i) }
      0 <= pointer_offset(p) + offset &&
      pointer_offset(p) + offset < block_length(pointer_block(p)) &&
      0 <= pointer_offset(p) + offset + i &&
      pointer_offset(p) + offset + i < block_length(pointer_block(p)) ==>
      ptrAdd(ptrAdd(p, offset), i) == ptrAdd(p, offset + i)),
    true]
  decreases
{
  true
}

function ptrAddAxiom2(): Bool
  ensures (forall p: Pointer, i: Int, j: Int ::
      { ptrAdd(p, i), ptrAdd(p, j) }
      0 <= pointer_offset(p) + i &&
      pointer_offset(p) + i < block_length(pointer_block(p)) &&
      0 <= pointer_offset(p) + j &&
      pointer_offset(p) + j < block_length(pointer_block(p)) ==>
      (i == j) == (ptrAdd(p, i) == ptrAdd(p, j)))
  decreases
{
  true
}

function sizeof_int(): Int
  ensures 2 <= result
  decreases


function v2loc(a: Vector[Any], i: Int): Any
  requires 0 <= i
  requires i < 2
  decreases
{
