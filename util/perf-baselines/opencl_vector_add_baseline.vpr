domain WellFoundedOrder[T]  {
  
  function bounded(v: T): Bool 
  
  function decreasing(v1: T, v2: T): Bool 
}

domain IntOrder  {
  
  axiom {
    (forall i: Int ::0 <= i == (bounded(i): Bool))
  }
  
  axiom {
    (forall i: Int ::(forall j: Int ::i < j == (decreasing(i, j): Bool)))
  }
}

domain Any  {
  
  
}

domain Vector[T1]  {
  
  function vector_loc(v: Vector[T1], i: Int): T1 
}

domain PointerCastHelper  {
  
  
}

domain Block  {
  
  function block_length(b: Block): Int 
  
  function loc(b: Block, i: Int): Ref 
  
  function block_address(b: Block): Int 
  
  function loc_inv_1(r: Ref): Block 
  
  function loc_inv_2(r: Ref): Int 
  
  function addr_inv(address: Int): Block 
  
  axiom {
    (forall b: Block :: { block_length(b) } block_length(b) >= 0)
  }
  
  axiom {
    (forall b: Block, i: Int ::
      { loc(b, i), loc(b, i) }
      loc_inv_1(loc(b, i)) == b && loc_inv_2(loc(b, i)) == i)
  }
  
  axiom {
    (forall b: Block :: { block_address(b) } block_address(b) > 0)
  }
}

domain Pointer  {
  
  function pointer_block(p: Pointer): Block 
  
  function pointer_offset(p: Pointer): Int 
  
  function pointer_inv(r: Ref): Pointer 
  
  function ptr_address(p: Pointer, stride: Int): Int 
  
  axiom {
    (forall p: Pointer ::
      { pointer_offset(p), pointer_offset(p) }
      pointer_offset(p) >= 0 &&
      pointer_offset(p) < block_length(pointer_block(p)))
  }
  
  axiom {
    (forall r: Ref :: { pointer_inv(r) } ptrDeref(pointer_inv(r)) == r)
  }
  
  axiom {
    (forall p: Pointer :: { ptrDeref(p) } pointer_inv(ptrDeref(p)) == p)
  }
  
  axiom {
    (forall p: Pointer, stride: Int ::
      { ptr_address(p, stride) }
      stride > 0 ==>
      ptr_address(p, stride) ==
      block_address(pointer_block(p)) + pointer_offset(p) * stride)
  }
  
  axiom {
    (forall p: Pointer, stride: Int ::
      { ptr_address(p, stride) }
      stride > 0 ==> ptr_address(p, stride) > 0)
  }
  
  axiom {
    (forall p1: Pointer, p2: Pointer, stride: Int ::
      { ptr_address(p1, stride), ptr_address(p2, stride), pointer_block(p1),
      pointer_block(p2) }
      stride > 0 &&
      (ptr_address(p1, stride) == ptr_address(p2, stride) &&
      pointer_block(p1) == pointer_block(p2)) ==>
      p1 == p2)
  }
  
  axiom {
    ptrAddAxiom()
  }
  
  axiom {
    ptrAddAxiom2()
  }
  
  axiom {
    (forall i: Pointer, i1: Int ::
      { ptr_address(i, i1) }
      ptr_address(i, i1) <= 18446744073709551615)
  }
}

domain Option[T2]  {
  
  function none1(): Option[T2] 
  
  function some(x: T2): Option[T2] 
  
  function option_get(opt: Option[T2]): T2 
  
  axiom {
    (forall x: T2 ::
      { (some(x): Option[T2]) }
      (none1(): Option[T2]) != (some(x): Option[T2]))
  }
  
  axiom {
    (forall x: T2 ::
      { (some(x): Option[T2]) }
      (option_get((some(x): Option[T2])): T2) == x)
  }
  
  axiom {
    (forall opt: Option[T2] ::
      { (some((option_get(opt): T2)): Option[T2]) }
      (some((option_get(opt): T2)): Option[T2]) == opt)
  }
}

domain Void  {
  
  function unit(): Void 
  
  axiom {
    (forall v: Void ::true ==> unit() == v)
  }
}

