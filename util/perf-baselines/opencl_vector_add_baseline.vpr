}

function optGet(opt: Option[Any]): Any
  requires opt != (none1(): Option[Any])
  ensures (some(result): Option[Any]) == opt
  decreases
{
  (option_get(opt): Any)
}

function optOrElse(opt: Option[Any], alt: Any): Any
  ensures opt == (none1(): Option[Any]) ==> result == alt
  ensures opt != (none1(): Option[Any]) ==> result == optGet(opt)
  decreases
{
  (opt == (none1(): Option[Any]) ? alt : optGet(opt))
}

function optGet1(opt: Option[Pointer]): Pointer
  requires opt != (none1(): Option[Pointer])
  ensures (some(result): Option[Pointer]) == opt
  decreases
{
  (option_get(opt): Pointer)
}

function v2loc1(a: Vector[Int], i: Int): Int
  requires 0 <= i
  requires i < 2
  decreases
{
  (vector_loc(a, i): Int)
}

function vload2(offset: Int, p: Option[Pointer]): Vector[Int]
  requires p != (none1(): Option[Pointer])
  requires 0 <= offset
  requires (offset + 1) * 2 <=
    block_length(pointer_block(optGet1(p))) - pointer_offset(optGet1(p))
  requires acc(ptrDeref(ptrAdd(optGet1(p), offset * 2)).int, wildcard)
  requires acc(ptrDeref(ptrAdd(optGet1(p), offset * 2 + 1)).int, wildcard)
  ensures p != (none1(): Option[Pointer])
  ensures 0 <= offset
  ensures (offset + 1) * 2 <=
    block_length(pointer_block(optGet1(p))) - pointer_offset(optGet1(p))
  ensures v2loc1(result, 0) == ptrDeref(ptrAdd(optGet1(p), offset * 2)).int
  ensures v2loc1(result, 1) ==
    ptrDeref(ptrAdd(optGet1(p), offset * 2 + 1)).int


