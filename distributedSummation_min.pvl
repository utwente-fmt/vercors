class Node {
  final int v;
  final int tid;
  int inMessage, outMessage, dummySend, dummyReceive, total;
  int n, frontN, backN;
}

requires N >= 2;
choreography DS(int N) {
  endpoint nodes[tid := 0 .. N] = Node();

  requires (\chor N >= 2);
  run {
    inhale (\endpoint nodes[i := 0 .. N]; Perm(nodes[i].outMessage, 1) ** Perm(nodes[i].inMessage, 1));
    inhale (\endpoint nodes[i := 0 .. N]; Perm(nodes[i].frontN, 1) ** Perm(nodes[i].backN, 1\2));
    inhale (\endpoint nodes[i := 0 .. N - 1], \forall int j = i + 1; Perm(nodes[j].backN, 1\2) ** {: nodes[i].frontN :} == {: nodes[j].backN :});

    label X;

    inhale (\endpoint nodes[N - 1]; Perm(nodes[0].backN, 1\2) ** nodes[N - 1].frontN == nodes[0].backN);

    assert (\endpoint nodes[i := 0 .. N - 1]; {: nodes[i].frontN :} == \old[X](nodes[i].frontN));
    assert (\endpoint nodes[i := 0 .. N - 1], \forall int j = i + 1; {: nodes[j].backN :} == \old[X](nodes[j].backN));
    assert (\endpoint nodes[i := 0 .. N - 1], \forall int j = i + 1; {: nodes[i].frontN :} == {: nodes[j].backN :});

    channel_invariant
      Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2) **
      {: \sender.frontN :}  == {: \receiver.backN :};
    communicate nodes[i := 0 .. N - 1]: nodes[i].outMessage -> nodes[i + 1].inMessage;

    channel_invariant
      Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2) **
      \sender.frontN == \receiver.backN;
    communicate nodes[0].inMessage <- nodes[N - 1].outMessage;

    assert (\endpoint nodes[i := 1 .. N], ∀int j = i - 1; {: nodes[j].frontN :} == {: nodes[i].backN :});

    channel_invariant
      Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2) **
      {: \sender.frontN :}  == {: \receiver.backN :};
    communicate nodes[i := 1 .. N]: nodes[i].outMessage -> nodes[i - 1].inMessage;

    channel_invariant
      Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2) **
      \sender.frontN == \receiver.backN;
    communicate nodes[0].inMessage -> nodes[N - 1].outMessage;
  }
}
