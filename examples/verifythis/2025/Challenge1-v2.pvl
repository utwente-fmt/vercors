ensures (\forall int i; {:1:i in xs:} == {:2:i in \result:});
ensures |xs| >= |\result|;
opaque pure set<int> toSet(seq<int> xs) = |xs| == 0 ? set<int> {} : {xs.head} + toSet(xs.tail);

requires xs != null ** Perm(xs[*], 1);
pure boolean inArr(int x, int[] xs) = (\exists int i = 0 .. xs.length; xs[i] == x);

requires xs != null ** Perm(xs[*], 1);
requires l in {0 .. xs.length + 1};
pure boolean inArr(int x, int[] xs, int l) = (\exists int i = l .. xs.length; xs[i] == x);

requires xs != null ** Perm(xs[*], 1);
requires i in {0 .. xs.length + 1};
ensures (\forall int k; {:1:inArr(k, xs, i):} == {:2:k in \result:});
ensures |\result| <= xs.length - i;
pure set<int> toSet(int[] xs, int i) = i == xs.length ? set<int> {} : {xs[i]} + toSet(xs, i + 1);

requires xs != null ** Perm(xs[*], 1);
ensures (\forall int k; {:1:inArr(k, xs):} == {:2:k in \result:});
ensures |\result| <= xs.length;
opaque pure set<int> toSet(int[] xs) = toSet(xs, 0);

requires a != null ** i in {0 .. a.length} ** j in {0 .. a.length} ** 
  Perm(a[i], 1) ** Perm(a[j], 1);
ensures Perm(a[i], 1) ** Perm(a[j], 1) **
  a[i] == \old(a[j]) ** a[j] == \old(a[i]);
void swap(int[] a, int i, int j) {
  a[j] = a[i] then { a[i] = a[j]; };
}

requires a != null ** Perm(a[*], 1);
ensures Perm(a[*], 1);
ensures \result in {0 .. a.length + 1};
ensures !inArr(\result, a);
ensures (∀int k = 0 .. \result; {: inArr(k, a) :});
int mex2(int[] a) {
  int n = a.length;
  int i = 0;

  loop_invariant Perm(a[*], 1);
  loop_invariant i in {0 .. n + 1};
  loop_invariant
    (\forall int j = 0 .. i; {: a[j] :} < 0 || a[j] >= n || a[j] == j || a[a[j]] == a[j]);
  while (i < n) {
    int x = a[i];
    if (x < 0 || x >= n || a[x] == x) {
      i = i + 1;
    } else if (x < i) {
      swap(a, i, x);
      i = i + 1;
    } else {
      swap(a, i, x);
    }
  }

  loop_invariant Perm(a[*], 1\2) ** (\forall int j = 0 .. i;  {: a[j] :} == j);
  loop_invariant (∀int j = 0 .. i; {: inArr(j, a) :});
  for (int i = 0 .. n) {
    if (a[i] != i) {
      return i;
    }
  }

  return n;
}

