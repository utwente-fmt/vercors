//:: cases PERF_INV_perm_1field
//:: tools silicon
//:: verdict Pass

// 1 Perm + 8 constraints, x3 methods.
// Compare to PERF-INV-arithmetic: heap encoding cost on top of arithmetic.
class PERF_INV_perm_1field_Node {
    int v1;
    int v2;
    int v3;

    requires Perm(this.v1, write) ** this.v1 >= 0 ** this.v1 <= n;
    void work1(int n) {
        loop_invariant
            Perm(this.v1, write) **
            this.v1 >= 0 ** this.v1 <= n **
            this.v1 + 1 > 0 **
            this.v1 + 2 > 1 **
            this.v1 + 3 > 2 **
            n - this.v1 >= 0 **
            n - this.v1 + 1 > 0 **
            n - this.v1 + 2 > 1 **
            n - this.v1 + 3 > 2;
        while (this.v1 < n) { this.v1 = this.v1 + 1; }
    }

    requires Perm(this.v2, write) ** this.v2 >= 0 ** this.v2 <= n;
    void work2(int n) {
        loop_invariant
            Perm(this.v2, write) **
            this.v2 >= 0 ** this.v2 <= n **
            this.v2 + 1 > 0 **
            this.v2 + 2 > 1 **
            this.v2 + 3 > 2 **
            n - this.v2 >= 0 **
            n - this.v2 + 1 > 0 **
            n - this.v2 + 2 > 1 **
            n - this.v2 + 3 > 2;
        while (this.v2 < n) { this.v2 = this.v2 + 1; }
    }

    requires Perm(this.v3, write) ** this.v3 >= 0 ** this.v3 <= n;
    void work3(int n) {
        loop_invariant
            Perm(this.v3, write) **
            this.v3 >= 0 ** this.v3 <= n **
            this.v3 + 1 > 0 **
            this.v3 + 2 > 1 **
            this.v3 + 3 > 2 **
            n - this.v3 >= 0 **
            n - this.v3 + 1 > 0 **
            n - this.v3 + 2 > 1 **
            n - this.v3 + 3 > 2;
        while (this.v3 < n) { this.v3 = this.v3 + 1; }
    }
}
