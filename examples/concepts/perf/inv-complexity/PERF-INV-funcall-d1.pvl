//:: cases PERF_INV_funcall_d1
//:: tools silicon
//:: verdict Pass

// Performance: loop invariant calls a pure function at depth 1.
// WD fix adds 1 extra inhale (the function's precondition) before the sat check.
// Baseline for comparing against funcall-d3 to measure WD collection overhead.
requires x > 0;
pure boolean isPositive(int x) = x > 0;

requires n > 0;
void perf_inv_funcall_d1(int n) {
    int i = 1;
    loop_invariant i > 0 && i <= n && isPositive(i);
    while (i < n) { i = i + 1; }
}
