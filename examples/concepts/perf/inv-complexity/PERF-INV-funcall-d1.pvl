//:: cases PERF_INV_funcall_d1
//:: tools silicon
//:: verdict Pass

// Invariant with 3 depth-1 function calls, x2 loops (6 calls total).
// Baseline: WD-collection cost per function call in the invariant.
requires x > 0;
pure boolean isPos(int x) = x > 0;

requires x >= 0;
pure boolean isNonNeg(int x) = x >= 0;

requires x >= 0 && y >= 0;
pure boolean sumPos(int x, int y) = x + y >= 0;

requires n > 0;
void perf_inv_funcall_d1(int n) {
    int i = 1;
    loop_invariant i > 0 && i <= n && isPos(i) && isNonNeg(i) && sumPos(i, n);
    while (i < n) { i = i + 1; }

    int k = 1;
    loop_invariant k > 0 && k <= n && isPos(k) && isNonNeg(k) && sumPos(k, n);
    while (k < n) { k = k + 1; }
}
