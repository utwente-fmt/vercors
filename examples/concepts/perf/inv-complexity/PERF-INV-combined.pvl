//:: cases PERF_INV_combined
//:: tools silicon
//:: verdict Pass

// 1 Perm + 2 foralls combined, x2 methods.
// Compare to perm-1field + forall separately: do costs add linearly or interact?
class PERF_INV_combined_Node {
    int v;
    int w;

    requires Perm(this.v, write) ** this.v >= 0 ** this.v <= n;
    void work1(int n) {
        loop_invariant
            Perm(this.v, write) **
            this.v >= 0 ** this.v <= n **
            (\forall int j = 0 .. this.v; j >= 0 && j < n && n - j > 0 && n - j <= n) **
            (\forall int j = 0 .. this.v; j >= 0 && j + this.v >= 0 && j + this.v <= 2 * n);
        while (this.v < n) { this.v = this.v + 1; }
    }

    requires Perm(this.w, write) ** this.w >= 0 ** this.w <= n;
    void work2(int n) {
        loop_invariant
            Perm(this.w, write) **
            this.w >= 0 ** this.w <= n **
            (\forall int j = 0 .. this.w; j >= 0 && j < n && n - j > 0 && n - j <= n) **
            (\forall int j = 0 .. this.w; j >= 0 && j + this.w >= 0 && j + this.w <= 2 * n);
        while (this.w < n) { this.w = this.w + 1; }
    }
}
