//:: cases PERF_INV_perm_5objects
//:: tools silicon
//:: verdict Pass

// Same as PERF-INV-perm-5fields but the 5 locations are 5 distinct objects.
// Tests whether cost depends on object count or just total Perm/conjunct count.
class PERF_INV_perm_5objects_Node {
    int v;
}

requires Perm(o1.v, write) ** Perm(o2.v, write) ** Perm(o3.v, write) **
         Perm(o4.v, write) ** Perm(o5.v, write) **
         o1.v >= 0 ** o1.v <= n **
         o2.v >= 0 ** o3.v >= 0 ** o4.v >= 0 ** o5.v >= 0;
void perf_inv_perm_5objects(
    PERF_INV_perm_5objects_Node o1, PERF_INV_perm_5objects_Node o2,
    PERF_INV_perm_5objects_Node o3, PERF_INV_perm_5objects_Node o4,
    PERF_INV_perm_5objects_Node o5, int n) {
    loop_invariant
        Perm(o1.v, write) ** Perm(o2.v, write) ** Perm(o3.v, write) **
        Perm(o4.v, write) ** Perm(o5.v, write) **
        o1.v >= 0 ** o1.v <= n **
        o1.v + 1 > 0 ** n - o1.v >= 0 **
        o2.v >= 0 ** o2.v + 1 > 0 ** o2.v + 2 > 1 **
        o3.v >= 0 ** o3.v + 1 > 0 ** o3.v + 2 > 1 **
        o4.v >= 0 ** o4.v + 1 > 0 ** o4.v + 2 > 1 **
        o5.v >= 0 ** o5.v + 1 > 0 ** o5.v + 2 > 1;
    while (o1.v < n) { o1.v = o1.v + 1; }
}
