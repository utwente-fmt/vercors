//:: cases PERF_INV_forall
//:: tools silicon
//:: verdict Pass

// 4 forall quantifiers x 2 loops (8 total) — trigger instantiation per j in 0..i.
// Compare to PERF-INV-arithmetic: same var count, quantifiers dominate here instead.
requires n >= 0;
void perf_inv_forall(int n) {
    int i = 0;
    loop_invariant i >= 0 && i <= n &&
        (\forall int j = 0 .. i; j >= 0 && j < n && n - j > 0 && n - j <= n) &&
        (\forall int j = 0 .. i; j >= 0 && j < i && i - j > 0 && i - j <= i) &&
        (\forall int j = 0 .. i; j >= 0 && j + i >= 0 && j + i <= 2 * n) &&
        (\forall int j = 0 .. i; j >= 0 && n - j >= 0 && n - j + i >= 0);
    while (i < n) { i = i + 1; }

    int k = 0;
    loop_invariant k >= 0 && k <= n &&
        (\forall int j = 0 .. k; j >= 0 && j < n && n - j > 0 && n - j <= n) &&
        (\forall int j = 0 .. k; j >= 0 && j < k && k - j > 0 && k - j <= k) &&
        (\forall int j = 0 .. k; j >= 0 && j + k >= 0 && j + k <= 2 * n) &&
        (\forall int j = 0 .. k; j >= 0 && n - j >= 0 && n - j + k >= 0);
    while (k < n) { k = k + 1; }
}
