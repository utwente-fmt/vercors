//:: cases PERF_INV_forall
//:: tools silicon
//:: verdict Pass

// Performance: loop invariant with a forall quantifier over the iteration range.
// Quantifier instantiation is expensive for SMT — compare to PERF-INV-arithmetic.
// The forall forces the solver to reason about all values 0..i simultaneously.
requires n >= 0;
void perf_inv_forall(int n) {
    int i = 0;
    loop_invariant i >= 0 && i <= n && (\forall int j = 0 .. i; j >= 0 && j < n);
    while (i < n) { i = i + 1; }
}
