//:: cases PERF_INV_arithmetic
//:: tools silicon
//:: verdict Pass

// Performance: single loop with a rich arithmetic invariant — many conjuncts, no heap.
// Baseline for comparing against Perm and forall variants.
// The invariant forces the solver to track several related integer constraints simultaneously.
requires n >= 0;
void perf_inv_arith(int n) {
    int i = 0;
    int cnt = 0;
    loop_invariant i >= 0 && i <= n && cnt >= 0 && cnt <= i && n - i >= 0 && i + cnt >= 0;
    while (i < n) {
        cnt = cnt + 1;
        i = i + 1;
    }
}
