//:: cases PERF_INV_arithmetic_light
//:: tools silicon
//:: verdict Pass

// Light pair for PERF-INV-arithmetic: 2 vars/6 conjuncts, 1 loop, no heap.
// Compare to see whether checkInvSat scales with conjunct/variable count.
requires n >= 0;
void perf_inv_arith_light(int n) {
    int i = 0; int a = 0;
    loop_invariant
        i >= 0 && i <= n &&
        a >= 0 && a <= i && a <= n &&
        a + i >= 0 && a + i <= 2 * n;
    while (i < n) { i = i + 1; a = a + 1; }
}
