//:: cases PERF_INV_funcall_d1_light
//:: tools silicon
//:: verdict Pass

// Light pair for PERF-INV-funcall-d1: 1 loop, 1 call instead of 3 calls x 2 loops.
// Compare to see whether WD-collection cost scales with call count.
requires x > 0;
pure boolean isPos(int x) = x > 0;

requires n > 0;
void perf_inv_funcall_d1_light(int n) {
    int i = 1;
    loop_invariant i > 0 && i <= n && isPos(i);
    while (i < n) { i = i + 1; }
}
