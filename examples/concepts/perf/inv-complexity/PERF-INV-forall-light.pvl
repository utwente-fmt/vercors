//:: cases PERF_INV_forall_light
//:: tools silicon
//:: verdict Pass

// Light pair for PERF-INV-forall: 1 loop, 1 forall instead of 4 x 2 loops.
// Compare to see whether cost scales with quantifier count.
requires n >= 0;
void perf_inv_forall_light(int n) {
    int i = 0;
    loop_invariant i >= 0 && i <= n &&
        (\forall int j = 0 .. i; j >= 0 && j < n && n - j > 0 && n - j <= n);
    while (i < n) { i = i + 1; }
}
