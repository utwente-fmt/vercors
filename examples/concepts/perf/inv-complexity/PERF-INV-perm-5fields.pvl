//:: cases PERF_INV_perm_5fields
//:: tools silicon
//:: verdict Pass

// Performance: loop invariant with five heap permissions.
// Tests whether permission count within a single invariant drives cost.
// Compare to PERF-INV-perm-1field: 5 Perm vs 1 Perm, same structure.
class PERF_INV_perm_5fields_Node {
    int a;
    int b;
    int c;
    int d;
    int e;

    requires Perm(this.a, write) ** Perm(this.b, write) ** Perm(this.c, write) **
             Perm(this.d, write) ** Perm(this.e, write) **
             this.a >= 0 && this.b >= 0 && this.c >= 0 && this.d >= 0 && this.e >= 0;
    void run(int n) {
        loop_invariant Perm(this.a, write) ** Perm(this.b, write) ** Perm(this.c, write) **
                       Perm(this.d, write) ** Perm(this.e, write) **
                       this.a >= 0 && this.b >= 0 && this.c >= 0 && this.d >= 0 && this.e >= 0 &&
                       this.a <= n;
        while (this.a < n) { this.a = this.a + 1; }
    }
}
