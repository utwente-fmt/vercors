//:: cases PERF_INV_perm_5fields
//:: tools silicon
//:: verdict Pass

// 5 Perms + 20 conjuncts, x2 methods — 5 heap locations vs 1 in perm-1field.
// Isolates heap-encoding scaling with location count.
class PERF_INV_perm_5fields_Node {
    int a;
    int b;
    int c;
    int d;
    int e;

    requires Perm(this.a, write) ** Perm(this.b, write) ** Perm(this.c, write) **
             Perm(this.d, write) ** Perm(this.e, write) **
             this.a >= 0 ** this.a <= n **
             this.b >= 0 ** this.c >= 0 ** this.d >= 0 ** this.e >= 0;
    void work1(int n) {
        loop_invariant
            Perm(this.a, write) ** Perm(this.b, write) ** Perm(this.c, write) **
            Perm(this.d, write) ** Perm(this.e, write) **
            this.a >= 0 ** this.a <= n **
            this.a + 1 > 0 ** n - this.a >= 0 **
            this.b >= 0 ** this.b + 1 > 0 ** this.b + 2 > 1 **
            this.c >= 0 ** this.c + 1 > 0 ** this.c + 2 > 1 **
            this.d >= 0 ** this.d + 1 > 0 ** this.d + 2 > 1 **
            this.e >= 0 ** this.e + 1 > 0 ** this.e + 2 > 1;
        while (this.a < n) { this.a = this.a + 1; }
    }

    requires Perm(this.a, write) ** Perm(this.b, write) ** Perm(this.c, write) **
             Perm(this.d, write) ** Perm(this.e, write) **
             this.b >= 0 ** this.b <= n **
             this.a >= 0 ** this.c >= 0 ** this.d >= 0 ** this.e >= 0;
    void work2(int n) {
        loop_invariant
            Perm(this.a, write) ** Perm(this.b, write) ** Perm(this.c, write) **
            Perm(this.d, write) ** Perm(this.e, write) **
            this.b >= 0 ** this.b <= n **
            this.b + 1 > 0 ** n - this.b >= 0 **
            this.a >= 0 ** this.a + 1 > 0 ** this.a + 2 > 1 **
            this.c >= 0 ** this.c + 1 > 0 ** this.c + 2 > 1 **
            this.d >= 0 ** this.d + 1 > 0 ** this.d + 2 > 1 **
            this.e >= 0 ** this.e + 1 > 0 ** this.e + 2 > 1;
        while (this.b < n) { this.b = this.b + 1; }
    }
}
