//:: cases PERF_INV_perm_light
//:: tools silicon
//:: verdict Pass

// Light pair for PERF-INV-perm-1field: 1 Perm + 2 constraints, 1 loop.
// Compare to see whether heap-encoding cost scales with conjunct count.
class PERF_INV_perm_light_Node {
    int v1;

    requires Perm(this.v1, write) ** this.v1 >= 0 ** this.v1 <= n;
    void work1(int n) {
        loop_invariant
            Perm(this.v1, write) **
            this.v1 >= 0 ** this.v1 <= n;
        while (this.v1 < n) { this.v1 = this.v1 + 1; }
    }
}
