//:: cases PERF_POST_perm
//:: tools silicon
//:: verdict Pass

// Postcondition calls 5 instance functions, each needing Perm on its own field —
// amplifies WD's per-call Perm inhale 5x.
class PERF_POST_perm_Node {
    int a;
    int b;
    int c;
    int d;
    int e;

    requires Perm(this.a, read) ** this.a > 0;
    pure boolean isPositiveA() = this.a > 0;

    requires Perm(this.b, read) ** this.b > 0;
    pure boolean isPositiveB() = this.b > 0;

    requires Perm(this.c, read) ** this.c > 0;
    pure boolean isPositiveC() = this.c > 0;

    requires Perm(this.d, read) ** this.d > 0;
    pure boolean isPositiveD() = this.d > 0;

    requires Perm(this.e, read) ** this.e > 0;
    pure boolean isPositiveE() = this.e > 0;
}

requires Perm(c.a, read) ** Perm(c.b, read) ** Perm(c.c, read) ** Perm(c.d, read) ** Perm(c.e, read) **
         c.a > 0 ** c.b > 0 ** c.c > 0 ** c.d > 0 ** c.e > 0;
ensures Perm(c.a, read) ** Perm(c.b, read) ** Perm(c.c, read) ** Perm(c.d, read) ** Perm(c.e, read) **
        c.a > 0 ** c.b > 0 ** c.c > 0 ** c.d > 0 ** c.e > 0;
ensures c.isPositiveA() && c.isPositiveB() && c.isPositiveC() && c.isPositiveD() && c.isPositiveE();
void perf_post_perm(PERF_POST_perm_Node c) { }
