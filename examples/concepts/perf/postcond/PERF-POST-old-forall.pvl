//:: cases PERF_POST_old_forall
//:: tools silicon
//:: verdict Pass

// \old inside a \forall range, applied to a heap field (meaningful, unlike on a
// value parameter). Only stripped from trigger positions by eliminateOldInTriggers.
class PERF_POST_old_forall {
    int n;

    requires Perm(n, write) ** n >= 0;
    ensures Perm(n, write) ** n == \old(n) + 1;
    ensures (\forall int i = 0 .. \old(n); i >= 0 && i < n);
    void bump() {
        n = n + 1;
    }
}
