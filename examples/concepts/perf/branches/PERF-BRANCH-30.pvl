    if (a > 40 && b > 40) { int p = a + b - 80; } else { int p = 0; }
    if (b > a + 30) { int q = b - a - 30; } else { int q = 0; }
    if (a + b > 300) { int r = a + b; } else { int r = a - b; }
    if (a > 60) { int s2 = a - 60; } else { int s2 = 60 - a; }
    if (b > a) { int t2 = b - a; } else { int t2 = a - b; }
    if (a + b > 50) { int u2 = a; } else { int u2 = b; }
    if (a > 10 && b > 10) { int v2 = a + b - 20; } else { int v2 = 0; }
    if (a > b + 5) { int w2 = a - b; } else { int w2 = b - a; }
    if (a + b > 80) { int x2 = a + b - 80; } else { int x2 = 0; }
    if (b > 20 && a > 20) { int y2 = a + b - 40; } else { int y2 = 0; }
    if (a > b + 15) { int z2 = a - b - 15; } else { int z2 = 0; }
    if (a + b > 120) { int p2 = a + b; } else { int p2 = a; }
    if (a > 25 && b > 25) { int q2 = a + b - 50; } else { int q2 = 0; }
    if (b > a + 5) { int r2 = b - a - 5; } else { int r2 = 0; }
    if (a + b > 400) { int s3 = a + b; } else { int s3 = b; }
    if (a > 70) { int t3 = a - 70; } else { int t3 = 70 - a; }
    if (b > a + 50) { int u3 = b - a; } else { int u3 = a - b; }
    if (a + b > 250) { int v3 = a + b; } else { int v3 = 0; }
    if (a > 80 && b > 80) { int w3 = a + b - 160; } else { int w3 = 0; }
    if (b > a + 25) { int x3 = b - a - 25; } else { int x3 = 0; }
    if (a + b > 180) { int y3 = a + b - 180; } else { int y3 = 0; }
    if (a > 35 && b > 35) { int z3 = a + b - 70; } else { int z3 = 0; }
}
