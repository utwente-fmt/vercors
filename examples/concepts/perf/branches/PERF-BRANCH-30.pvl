// Performance: 30 sequential if-else branches, two variables, non-empty bodies.
// detectDeadCode: 60 Refutes. Stress test for branch count scaling with non-trivial state.
requires a >= 0 && b >= 0;
void perf_branch_30(int a, int b) {
    if (a > b) { int s = a - b; } else { int s = b - a; }
    if (a + b > 100) { int t = a + b - 100; } else { int t = 100 - a - b; }
