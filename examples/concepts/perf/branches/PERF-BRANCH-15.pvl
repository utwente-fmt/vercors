//:: cases PERF_BRANCH_15
//:: tools silicon
//:: verdict Pass

// Performance: 15 sequential if-else branches, two variables, non-empty bodies.
// detectDeadCode: 30 Refutes; each checks a multi-variable path condition.
// Bodies assign to locals so Silicon tracks symbolic values per branch.
requires a >= 0 && b >= 0;
void perf_branch_15(int a, int b) {
    if (a > b) { int s = a - b; } else { int s = b - a; }
    if (a + b > 100) { int t = a + b - 100; } else { int t = 100 - a - b; }
    if (a > 50 && b > 50) { int u = a + b; } else { int u = 0; }
    if (b > a + 10) { int v = b - a; } else { int v = a; }
    if (a + b > 200) { int w = a + b; } else { int w = 0; }
    if (a > b + 20) { int x = a - b - 20; } else { int x = 0; }
    if (b > 75) { int y = b - 75; } else { int y = b; }
    if (a + b > 150 && a > 30) { int z = a + b; } else { int z = a; }
    if (a > 40 && b > 40) { int p = a + b - 80; } else { int p = 0; }
    if (b > a + 30) { int q = b - a - 30; } else { int q = 0; }
    if (a + b > 300) { int r = a + b; } else { int r = a - b; }
    if (a > 60) { int s2 = a - 60; } else { int s2 = 60 - a; }
    if (b > a) { int t2 = b - a; } else { int t2 = a - b; }
    if (a + b > 50) { int u2 = a; } else { int u2 = b; }
    if (a > 10 && b > 10) { int v2 = a + b - 20; } else { int v2 = 0; }
}
