//:: cases PERF_BRANCH_indep_10
//:: tools silicon
//:: verdict Pass

// Performance: 10 sequential if statements (no else), one independent variable per branch.
// Each condition touches a unique parameter -- accumulated path conditions are
// a conjunction of INDEPENDENT simple inequalities. Z3 can factor them trivially.
// Compare to PERF-BRANCH-single-var-10.pvl (shared variables) to isolate variable-sharing cost.
void perf_branch_indep_10(int v1, int v2, int v3, int v4, int v5, int v6, int v7, int v8, int v9, int v10) {
    if (v1 > 0) { int r1 = v1; }
    if (v2 > 0) { int r2 = v2; }
    if (v3 > 0) { int r3 = v3; }
    if (v4 > 0) { int r4 = v4; }
    if (v5 > 0) { int r5 = v5; }
    if (v6 > 0) { int r6 = v6; }
    if (v7 > 0) { int r7 = v7; }
    if (v8 > 0) { int r8 = v8; }
    if (v9 > 0) { int r9 = v9; }
    if (v10 > 0) { int r10 = v10; }
}
