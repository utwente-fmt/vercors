//:: cases PERF_BRANCH_chain_10
//:: tools silicon
//:: verdict Pass

// 10-way chain with two-variable conditions — harder than single-variable chains.
// Compare to PERF-BRANCH-chain-5 and PERF-BRANCH-chain-15.
requires a >= 0 && b >= 0 && a + b <= 2000;
void perf_branch_chain_10(int a, int b) {
    if (a + b > 1800) {
        int s = a + b - 1800;
    } else if (a > b + 500) {
        int s = a - b - 500;
    } else if (b > a + 400) {
        int s = b - a - 400;
    } else if (a + b > 1400) {
        int s = a + b - 1400;
    } else if (a > b + 200) {
        int s = a - b - 200;
    } else if (b > a + 150) {
        int s = b - a - 150;
    } else if (a + b > 1000) {
        int s = a + b - 1000;
    } else if (a > b + 50) {
        int s = a - b - 50;
    } else if (b > a + 30) {
        int s = b - a - 30;
    } else {
        int s = 0;
    }
}
