// Performance: 10-way if-elseif-...-else chain (mutually exclusive, 11 paths total),
// each condition on its own INDEPENDENT variable -- same variable count as
// PERF-BRANCH-indep-10.pvl, but chained (linear path count) instead of sequential
// (multiplicative path count). Isolates: does variable independence by itself
// cause exponential blowup, or only when combined with sequential (non-exclusive)
// branch structure?
void perf_branch_chain_indep_10(int v1, int v2, int v3, int v4, int v5, int v6, int v7, int v8, int v9, int v10) {
    if (v1 > 0) {
        int s = v1;
    } else if (v2 > 0) {
        int s = v2;
    } else if (v3 > 0) {
        int s = v3;
    } else if (v4 > 0) {
        int s = v4;
    } else if (v5 > 0) {
        int s = v5;
    } else if (v6 > 0) {
        int s = v6;
    } else if (v7 > 0) {
        int s = v7;
    } else if (v8 > 0) {
        int s = v8;
    } else if (v9 > 0) {
        int s = v9;
    } else if (v10 > 0) {
        int s = v10;
    } else {
        int s = 0;
    }
}
