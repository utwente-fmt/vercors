//:: cases PERF_BRANCH_chain_15
//:: tools silicon
//:: verdict Pass

// Performance: 15-way chain with two-variable conditions, all branches live.
// detectDeadCode: 15 Refutes; the final else carries 14 accumulated multi-variable negations.
// Stress test for deep chaining with non-trivial path condition accumulation.
requires a >= 0 && b >= 0 && a + b <= 3000;
void perf_branch_chain_15(int a, int b) {
    if (a + b > 2800) {
        int s = a + b - 2800;
    } else if (a > b + 800) {
        int s = a - b - 800;
    } else if (b > a + 700) {
        int s = b - a - 700;
    } else if (a + b > 2400) {
        int s = a + b - 2400;
    } else if (a > b + 500) {
        int s = a - b - 500;
    } else if (b > a + 400) {
        int s = b - a - 400;
    } else if (a + b > 2000) {
        int s = a + b - 2000;
    } else if (a > b + 300) {
        int s = a - b - 300;
    } else if (b > a + 200) {
        int s = b - a - 200;
    } else if (a + b > 1500) {
        int s = a + b - 1500;
    } else if (a > b + 100) {
        int s = a - b - 100;
    } else if (b > a + 80) {
        int s = b - a - 80;
    } else if (a + b > 800) {
        int s = a + b - 800;
    } else if (a > b + 30) {
        int s = a - b - 30;
    } else {
        int s = 0;
    }
}
