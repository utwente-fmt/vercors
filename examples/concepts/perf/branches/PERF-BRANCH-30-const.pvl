//:: cases PERF_BRANCH_30_const
//:: tools silicon
//:: verdict Fail

// Control: same 30 branches as PERF-BRANCH-30 but all conditions are `true`.
// Compare timing to PERF-BRANCH-30 to isolate condition cost from Refute overhead.
requires a >= 0 && b >= 0;
void perf_branch_30_const(int a, int b) {
    if (true) { int s = a - b; } else { int s = b - a; }
    if (true) { int t = a + b - 100; } else { int t = 100 - a - b; }
    if (true) { int u = a + b; } else { int u = 0; }
    if (true) { int v = b - a; } else { int v = a; }
    if (true) { int w = a + b; } else { int w = 0; }
    if (true) { int x = a - b - 20; } else { int x = 0; }
    if (true) { int y = b - 75; } else { int y = b; }
    if (true) { int z = a + b; } else { int z = a; }
    if (true) { int p = a + b - 80; } else { int p = 0; }
    if (true) { int q = b - a - 30; } else { int q = 0; }
    if (true) { int r = a + b; } else { int r = a - b; }
    if (true) { int s2 = a - 60; } else { int s2 = 60 - a; }
    if (true) { int t2 = b - a; } else { int t2 = a - b; }
    if (true) { int u2 = a; } else { int u2 = b; }
    if (true) { int v2 = a + b - 20; } else { int v2 = 0; }
    if (true) { int w2 = a - b; } else { int w2 = b - a; }
    if (true) { int x2 = a + b - 80; } else { int x2 = 0; }
    if (true) { int y2 = a + b - 40; } else { int y2 = 0; }
    if (true) { int z2 = a - b - 15; } else { int z2 = 0; }
    if (true) { int p2 = a + b; } else { int p2 = a; }
    if (true) { int q2 = a + b - 50; } else { int q2 = 0; }
    if (true) { int r2 = b - a - 5; } else { int r2 = 0; }
    if (true) { int s3 = a + b; } else { int s3 = b; }
    if (true) { int t3 = a - 70; } else { int t3 = 70 - a; }
    if (true) { int u3 = b - a; } else { int u3 = a - b; }
    if (true) { int v3 = a + b; } else { int v3 = 0; }
    if (true) { int w3 = a + b - 160; } else { int w3 = 0; }
    if (true) { int x3 = b - a - 25; } else { int x3 = 0; }
    if (true) { int y3 = a + b - 180; } else { int y3 = 0; }
    if (true) { int z3 = a + b - 70; } else { int z3 = 0; }
}
