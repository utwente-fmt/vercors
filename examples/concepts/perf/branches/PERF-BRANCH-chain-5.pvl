//:: cases PERF_BRANCH_chain_5
//:: tools silicon
//:: verdict Pass

// Performance: 5-way chain with two-variable conditions. Each branch's
// reachability check carries accumulated negations of prior multi-variable
// conditions, which is harder for the solver than single-variable chains.
requires a >= 0 && b >= 0;
void perf_branch_chain_5(int a, int b) {
    if (a + b > 400) {
        int s = a + b - 400;
    } else if (a > b + 100) {
        int s = a - b - 100;
    } else if (b > a + 50) {
        int s = b - a - 50;
    } else if (a + b > 200) {
        int s = a + b - 200;
    } else {
        int s = 0;
    }
}
