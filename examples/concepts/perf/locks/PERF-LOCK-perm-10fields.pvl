//:: cases PERF_LOCK_perm_10fields
//:: tools silicon
//:: verdict Pass

// Performance: lock invariant with ten field permissions. Single lock site.
// checkLockInvSat: FramedProof must inhale 10 Perm grants + 10 value constraints.
// Compare to PERF-LOCK-perm-1field/5fields: does permission count in lock invariant drive cost?
lock_invariant Perm(a, write) ** Perm(b, write) ** Perm(c, write) ** Perm(d, write) ** Perm(e, write) **
              Perm(f, write) ** Perm(g, write) ** Perm(h, write) ** Perm(i, write) ** Perm(j, write) **
              (a >= 0 && b >= 0 && c >= 0 && d >= 0 && e >= 0 &&
               f >= 0 && g >= 0 && h >= 0 && i >= 0 && j >= 0);
class PERF_LOCK_perm_10fields {
    int a;
    int b;
    int c;
    int d;
    int e;
    int f;
    int g;
    int h;
    int i;
    int j;

    ensures committed(this);
    constructor() {
        a = 0; b = 0; c = 0; d = 0; e = 0;
        f = 0; g = 0; h = 0; i = 0; j = 0;
        commit this;
    }

    requires committed(this);
    void work() {
        lock this;
        a = a + 1;
        unlock this;
    }
}
