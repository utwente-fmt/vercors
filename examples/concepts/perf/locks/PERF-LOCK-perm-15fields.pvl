//:: cases PERF_LOCK_perm_15fields
//:: tools silicon
//:: verdict Pass

// Performance: lock invariant with fifteen field permissions. Single lock site.
// checkLockInvSat: FramedProof must inhale 15 Perm grants + 15 value constraints.
// Compare to PERF-LOCK-perm-1field/5fields/10fields: does permission count in lock invariant drive cost?
lock_invariant Perm(a, write) ** Perm(b, write) ** Perm(c, write) ** Perm(d, write) ** Perm(e, write) **
              Perm(f, write) ** Perm(g, write) ** Perm(h, write) ** Perm(i, write) ** Perm(j, write) **
              Perm(k, write) ** Perm(l, write) ** Perm(m, write) ** Perm(n, write) ** Perm(o, write) **
              (a >= 0 && b >= 0 && c >= 0 && d >= 0 && e >= 0 &&
               f >= 0 && g >= 0 && h >= 0 && i >= 0 && j >= 0 &&
               k >= 0 && l >= 0 && m >= 0 && n >= 0 && o >= 0);
class PERF_LOCK_perm_15fields {
    int a;
    int b;
    int c;
    int d;
    int e;
    int f;
    int g;
    int h;
    int i;
    int j;
    int k;
    int l;
    int m;
    int n;
    int o;

    ensures committed(this);
    constructor() {
        a = 0; b = 0; c = 0; d = 0; e = 0;
        f = 0; g = 0; h = 0; i = 0; j = 0;
        k = 0; l = 0; m = 0; n = 0; o = 0;
        commit this;
    }

    requires committed(this);
    void work() {
        lock this;
        a = a + 1;
        unlock this;
    }
}
