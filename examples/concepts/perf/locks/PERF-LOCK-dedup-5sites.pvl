//:: cases PERF_LOCK_dedup_5sites
//:: tools silicon
//:: verdict Pass

// 1 class locked 5 times — checkLockInvSat dedups to 1 FramedProof.
// Compare to PERF-LOCK-perm-1field (should match) and PERF-LOCK-5classes (inverse case).
lock_invariant Perm(value, write) ** value >= 0;
class PERF_LOCK_dedup {
    int value;

    ensures committed(this);
    constructor() { value = 0; commit this; }

    requires committed(this); void run1() { lock this; value = value + 1; unlock this; }
    requires committed(this); void run2() { lock this; value = value + 1; unlock this; }
    requires committed(this); void run3() { lock this; value = value + 1; unlock this; }
    requires committed(this); void run4() { lock this; value = value + 1; unlock this; }
    requires committed(this); void run5() { lock this; value = value + 1; unlock this; }
}
