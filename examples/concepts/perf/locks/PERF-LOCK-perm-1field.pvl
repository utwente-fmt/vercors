//:: cases PERF_LOCK_perm_1field
//:: tools silicon
//:: verdict Pass

// Performance: lock invariant with one field permission. Single lock site.
// checkLockInvSat: 1 FramedProof { Inhale(Perm(value,write) ** value >= 0); Refute(ff) }.
// Baseline for lock invariant complexity tests.
lock_invariant Perm(value, write) ** value >= 0;
class PERF_LOCK_perm_1field {
    int value;

    ensures committed(this);
    constructor() {
        value = 0;
        commit this;
    }

    requires committed(this);
    void work() {
        lock this;
        value = value + 1;
        unlock this;
    }
}
