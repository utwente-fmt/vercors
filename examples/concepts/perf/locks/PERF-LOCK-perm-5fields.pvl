//:: cases PERF_LOCK_perm_5fields
//:: tools silicon
//:: verdict Pass

// Performance: lock invariant with five field permissions. Single lock site.
// checkLockInvSat: FramedProof must inhale 5 Perm grants + 5 value constraints.
// Compare to PERF-LOCK-perm-1field: does permission count in lock invariant drive cost?
lock_invariant Perm(a, write) ** Perm(b, write) ** Perm(c, write) ** Perm(d, write) ** Perm(e, write) **
              a >= 0 && b >= 0 && c >= 0 && d >= 0 && e >= 0;
class PERF_LOCK_perm_5fields {
    int a;
    int b;
    int c;
    int d;
    int e;

    ensures committed(this);
    constructor() {
        a = 0; b = 0; c = 0; d = 0; e = 0;
        commit this;
    }

    requires committed(this);
    void run() {
        lock this;
        a = a + 1;
        unlock this;
    }
}
