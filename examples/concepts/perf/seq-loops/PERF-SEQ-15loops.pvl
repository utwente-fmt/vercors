    loop_invariant i12 >= 0 && i12 <= n && c12 == i12 && (\forall int j = 0 .. i12; j >= 0 && j < n);
    while (i12 < n) { c12 = c12 + 1; i12 = i12 + 1; }

    int i13 = 0; int c13 = 0;
    loop_invariant i13 >= 0 && i13 <= n && c13 == i13 && (\forall int j = 0 .. i13; j >= 0 && j < n);
    while (i13 < n) { c13 = c13 + 1; i13 = i13 + 1; }

