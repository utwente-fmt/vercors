//:: cases PERF_SEQ_15loops
//:: tools silicon
//:: verdict Pass

// Performance: 15 sequential loops, forall invariant at each.
// checkInvSat: 15 independent FramedProofs — linear cost.
// detectDeadCode: 30 Refutes; the 15th loop's body Refute carries 14 post-loop forall
// facts in its path condition — a system of 14 quantified formulas for Z3 to reason over.
// Stress test for accumulated path condition weight with quantifiers.
requires n >= 0;
void perf_seq_15(int n) {
    int i1 = 0; int c1 = 0;
    loop_invariant i1 >= 0 && i1 <= n && c1 == i1 && (\forall int j = 0 .. i1; j >= 0 && j < n);
    while (i1 < n) { c1 = c1 + 1; i1 = i1 + 1; }

    int i2 = 0; int c2 = 0;
    loop_invariant i2 >= 0 && i2 <= n && c2 == i2 && (\forall int j = 0 .. i2; j >= 0 && j < n);
