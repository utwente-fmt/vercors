//:: cases PERF_SEQ_1loop
//:: tools silicon
//:: verdict Pass

// Baseline: 1 loop with a forall invariant — quantifier instantiation cost floor.
requires n >= 0;
void perf_seq_1(int n) {
    int i = 0;
    int cnt = 0;
    loop_invariant i >= 0 && i <= n && cnt == i && (\forall int j = 0 .. i; j >= 0 && j < n);
    while (i < n) {
        cnt = cnt + 1;
        i = i + 1;
    }
}
