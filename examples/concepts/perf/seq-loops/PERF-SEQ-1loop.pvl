//:: cases PERF_SEQ_1loop
//:: tools silicon
//:: verdict Pass

// Performance baseline: 1 loop with forall invariant and counter tracking.
// checkInvSat: 1 FramedProof — inhales forall, checks SAT.
// detectDeadCode: 2 Refutes (body + post-loop), each checking a forall path condition.
// The forall forces Z3 quantifier instantiation per Refute — measurably heavier than plain arithmetic.
requires n >= 0;
void perf_seq_1(int n) {
    int i = 0;
    int cnt = 0;
    loop_invariant i >= 0 && i <= n && cnt == i && (\forall int j = 0 .. i; j >= 0 && j < n);
    while (i < n) {
        cnt = cnt + 1;
        i = i + 1;
    }
}
