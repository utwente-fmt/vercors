//:: cases PERF_PRECOND_funcall_d3
//:: tools silicon
//:: verdict Pass

// Performance: precondition contains a 3-deep nested function call.
// Compare to PERF-PRECOND-simple to see function-call/WD overhead in checkSat.
requires x > 0;
pure int lift1(int x) = x + 1;

requires x > 0;
pure int lift2(int x) = x + 1;

requires x > 0;
pure boolean above0(int x) = x > 0;

requires n > 0 && above0(lift2(lift1(n)));
void perf_precond_funcall_d3(int n) { }
