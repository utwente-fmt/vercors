//:: cases PERF_NEST_2level
//:: tools silicon
//:: verdict Pass

// 2-level nested loops — inner Refute carries 2 quantifiers at once, not 1.
// Compare to PERF-SEQ-5loops: same Refute count, richer path state.
requires n >= 0 && m >= 0;
void perf_nest_2(int n, int m) {
    int i = 0; int ci = 0;
    loop_invariant i >= 0 && i <= n && ci == i && (\forall int k = 0 .. i; k >= 0 && k < n);
    while (i < n) {
        int j = 0; int cj = 0;
        loop_invariant j >= 0 && j <= m && cj == j && (\forall int k = 0 .. j; k >= 0 && k < m);
        while (j < m) {
            cj = cj + 1;
            j = j + 1;
        }
        ci = ci + 1;
        i = i + 1;
    }
}
