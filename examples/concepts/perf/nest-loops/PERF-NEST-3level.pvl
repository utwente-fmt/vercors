//:: cases PERF_NEST_3level
//:: tools silicon
//:: verdict Pass

// Same as PERF-NEST-2level but 3 levels deep.
requires n >= 0 && m >= 0 && p >= 0;
void perf_nest_3(int n, int m, int p) {
    int i = 0; int ci = 0;
    loop_invariant i >= 0 && i <= n && ci == i && (\forall int k = 0 .. i; k >= 0 && k < n);
    while (i < n) {
        int j = 0; int cj = 0;
        loop_invariant j >= 0 && j <= m && cj == j && (\forall int k = 0 .. j; k >= 0 && k < m);
        while (j < m) {
            int l = 0; int cl = 0;
            loop_invariant l >= 0 && l <= p && cl == l && (\forall int k = 0 .. l; k >= 0 && k < p);
            while (l < p) {
                cl = cl + 1;
                l = l + 1;
            }
            cj = cj + 1;
            j = j + 1;
        }
        ci = ci + 1;
        i = i + 1;
    }
}
