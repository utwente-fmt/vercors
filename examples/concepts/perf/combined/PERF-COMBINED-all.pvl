//:: cases PERF_COMBINED_all
//:: tools silicon
//:: verdict Pass

// Performance: all five checkers active simultaneously on a single complex method.
// Contains: lock with permission invariant, loop with function-call invariant,
// branches inside the loop, and a non-trivial postcondition.
// Tests whether total cost is additive (sum of individual checker costs) or whether
// the checkers interfere and produce superlinear overhead.
requires x > 0;
pure boolean above0(int x) = x > 0;

lock_invariant Perm(counter, write) ** counter >= 0;
class PERF_COMBINED_Obj {
    int counter;

    ensures committed(this);
    constructor() { counter = 0; commit this; }

    requires committed(this) ** n >= 0;
    ensures committed(this);
    void run(int n) {
        lock this;
        int i = 1;
        loop_invariant Perm(this.counter, write) ** this.counter >= 0 && i > 0 && i <= n + 1 && above0(i);
        while (i <= n) {
            if (i > 0) { this.counter = this.counter + 1; } else { }
            i = i + 1;
        }
        unlock this;
    }
}
