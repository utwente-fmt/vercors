//:: cases PERF_REAL_event_processor
//:: tools silicon
//:: verdict Pass

// Real-life combined: thread-safe event dispatcher with 10 priority buckets,
// each routed via a 10-way chain branch inside a loop with a forall invariant
// and a 10-field lock invariant. Expected: Pass.

lock_invariant Perm(c0, write) ** Perm(c1, write) ** Perm(c2, write) ** Perm(c3, write) ** Perm(c4, write) **
               Perm(c5, write) ** Perm(c6, write) ** Perm(c7, write) ** Perm(c8, write) ** Perm(c9, write) **
               c0 >= 0 ** c1 >= 0 ** c2 >= 0 ** c3 >= 0 ** c4 >= 0 **
               c5 >= 0 ** c6 >= 0 ** c7 >= 0 ** c8 >= 0 ** c9 >= 0;
class PERF_REAL_EventProcessor {
    int c0;
    int c1;
    int c2;
    int c3;
    int c4;
    int c5;
    int c6;
    int c7;
    int c8;
    int c9;

    ensures committed(this);
    constructor() {
        c0 = 0; c1 = 0; c2 = 0; c3 = 0; c4 = 0;
        c5 = 0; c6 = 0; c7 = 0; c8 = 0; c9 = 0;
        commit this;
    }

    requires committed(this) ** n >= 0 **
             t0 >= 0 ** t1 >= t0 ** t2 >= t1 ** t3 >= t2 ** t4 >= t3 **
             t5 >= t4 ** t6 >= t5 ** t7 >= t6 ** t8 >= t7 ** t8 <= n;
    ensures committed(this);
    void dispatch(int n, int t0, int t1, int t2, int t3, int t4, int t5, int t6, int t7, int t8) {
        lock this;
        int i = 0;
        loop_invariant Perm(this.c0, write) ** Perm(this.c1, write) ** Perm(this.c2, write) **
                       Perm(this.c3, write) ** Perm(this.c4, write) ** Perm(this.c5, write) **
                       Perm(this.c6, write) ** Perm(this.c7, write) ** Perm(this.c8, write) **
                       Perm(this.c9, write) **
                       this.c0 >= 0 ** this.c1 >= 0 ** this.c2 >= 0 ** this.c3 >= 0 ** this.c4 >= 0 **
                       this.c5 >= 0 ** this.c6 >= 0 ** this.c7 >= 0 ** this.c8 >= 0 ** this.c9 >= 0 **
                       i >= 0 ** i <= n ** (\forall int j = 0 .. i; j >= 0 && j < n);
        while (i < n) {
            if (i < t0) {
                this.c0 = this.c0 + 1;
            } else if (i < t1) {
                this.c1 = this.c1 + 1;
            } else if (i < t2) {
                this.c2 = this.c2 + 1;
            } else if (i < t3) {
                this.c3 = this.c3 + 1;
            } else if (i < t4) {
                this.c4 = this.c4 + 1;
            } else if (i < t5) {
                this.c5 = this.c5 + 1;
            } else if (i < t6) {
                this.c6 = this.c6 + 1;
            } else if (i < t7) {
                this.c7 = this.c7 + 1;
            } else if (i < t8) {
                this.c8 = this.c8 + 1;
            } else {
                this.c9 = this.c9 + 1;
            }
            i = i + 1;
        }
        unlock this;
    }

    requires committed(this);
    ensures committed(this);
    void reset() {
        lock this;
        this.c0 = 0; this.c1 = 0; this.c2 = 0; this.c3 = 0; this.c4 = 0;
        this.c5 = 0; this.c6 = 0; this.c7 = 0; this.c8 = 0; this.c9 = 0;
        unlock this;
    }
}
