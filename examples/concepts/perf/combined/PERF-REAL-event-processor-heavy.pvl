//:: cases PERF_REAL_event_processor_heavy
//:: tools silicon
//:: verdict Pass

// Heavy combined stress test. Exercises all four smoke checks simultaneously:
//   checkLockInvSat:   15-field lock invariant (vs 10 in base EP)
//   checkLoopInvSat:   15-perm loop invariant + forall in two dispatch loops
//   detectDeadCode:    4 independent sequential if/else per loop iteration (not chains)
//                      + 3 independent if/else per par-block thread
//   checkPostSat:      multi-conjunct postconditions on merge() and processEvents()
// assume statements provide explicit solver hints inside loop bodies.

lock_invariant Perm(c0, write) ** Perm(c1, write) ** Perm(c2, write) ** Perm(c3, write) ** Perm(c4, write) **
               Perm(c5, write) ** Perm(c6, write) ** Perm(c7, write) ** Perm(c8, write) ** Perm(c9, write) **
               Perm(c10, write) ** Perm(c11, write) ** Perm(c12, write) ** Perm(c13, write) ** Perm(c14, write) **
               c0 >= 0 ** c1 >= 0 ** c2 >= 0 ** c3 >= 0 ** c4 >= 0 **
               c5 >= 0 ** c6 >= 0 ** c7 >= 0 ** c8 >= 0 ** c9 >= 0 **
               c10 >= 0 ** c11 >= 0 ** c12 >= 0 ** c13 >= 0 ** c14 >= 0;
class PERF_REAL_EventProcessorHeavy {
    int c0; int c1; int c2; int c3; int c4;
    int c5; int c6; int c7; int c8; int c9;
    int c10; int c11; int c12; int c13; int c14;

    ensures committed(this);
    constructor() {
        c0 = 0; c1 = 0; c2 = 0; c3 = 0; c4 = 0;
        c5 = 0; c6 = 0; c7 = 0; c8 = 0; c9 = 0;
        c10 = 0; c11 = 0; c12 = 0; c13 = 0; c14 = 0;
        commit this;
    }

    // dispatch: 4 INDEPENDENT sequential if/else per iteration (not chained).
    // Each iteration has 16 paths through the body — stresses detectDeadCode.
    requires committed(this) ** n >= 0 ** t0 >= 0 ** t1 >= 0 ** t2 >= 0 ** t3 >= 0;
    ensures committed(this);
    void dispatch(int n, int t0, int t1, int t2, int t3) {
        lock this;
        int i = 0;
        loop_invariant Perm(this.c0, write) ** Perm(this.c1, write) ** Perm(this.c2, write) **
                       Perm(this.c3, write) ** Perm(this.c4, write) ** Perm(this.c5, write) **
                       Perm(this.c6, write) ** Perm(this.c7, write) ** Perm(this.c8, write) **
                       Perm(this.c9, write) ** Perm(this.c10, write) ** Perm(this.c11, write) **
                       Perm(this.c12, write) ** Perm(this.c13, write) ** Perm(this.c14, write) **
                       this.c0 >= 0 ** this.c1 >= 0 ** this.c2 >= 0 ** this.c3 >= 0 ** this.c4 >= 0 **
                       this.c5 >= 0 ** this.c6 >= 0 ** this.c7 >= 0 ** this.c8 >= 0 ** this.c9 >= 0 **
                       this.c10 >= 0 ** this.c11 >= 0 ** this.c12 >= 0 ** this.c13 >= 0 ** this.c14 >= 0 **
                       i >= 0 ** i <= n ** (\forall int j = 0 .. i; j >= 0 && j < n + 1);
        while (i < n) {
            // 4 independent branches (each condition is on independent variables)
            if (i < t0) { this.c0 = this.c0 + 1; } else { this.c1 = this.c1 + 1; }
            if (i < t1) { this.c2 = this.c2 + 1; } else { this.c3 = this.c3 + 1; }
            if (i < t2) { this.c4 = this.c4 + 1; } else { this.c5 = this.c5 + 1; }
            if (i < t3) { this.c6 = this.c6 + 1; } else { this.c7 = this.c7 + 1; }
            assume i >= 0 && i < n;
            i = i + 1;
        }
        unlock this;
    }

    // dispatchHigh: same structure, different buckets (c8..c14 + c0).
    requires committed(this) ** n >= 0 ** s0 >= 0 ** s1 >= 0 ** s2 >= 0 ** s3 >= 0;
    ensures committed(this);
    void dispatchHigh(int n, int s0, int s1, int s2, int s3) {
        lock this;
        int k = 0;
        loop_invariant Perm(this.c0, write) ** Perm(this.c1, write) ** Perm(this.c2, write) **
                       Perm(this.c3, write) ** Perm(this.c4, write) ** Perm(this.c5, write) **
                       Perm(this.c6, write) ** Perm(this.c7, write) ** Perm(this.c8, write) **
                       Perm(this.c9, write) ** Perm(this.c10, write) ** Perm(this.c11, write) **
                       Perm(this.c12, write) ** Perm(this.c13, write) ** Perm(this.c14, write) **
                       this.c0 >= 0 ** this.c1 >= 0 ** this.c2 >= 0 ** this.c3 >= 0 ** this.c4 >= 0 **
                       this.c5 >= 0 ** this.c6 >= 0 ** this.c7 >= 0 ** this.c8 >= 0 ** this.c9 >= 0 **
                       this.c10 >= 0 ** this.c11 >= 0 ** this.c12 >= 0 ** this.c13 >= 0 ** this.c14 >= 0 **
                       k >= 0 ** k <= n ** (\forall int j = 0 .. k; j >= 0 && j < n + 1);
        while (k < n) {
            if (k < s0) { this.c8  = this.c8  + 1; } else { this.c9  = this.c9  + 1; }
            if (k < s1) { this.c10 = this.c10 + 1; } else { this.c11 = this.c11 + 1; }
            if (k < s2) { this.c12 = this.c12 + 1; } else { this.c13 = this.c13 + 1; }
            if (k < s3) { this.c14 = this.c14 + 1; } else { this.c0  = this.c0  + 1; }
            assume k >= 0 && k < n;
            k = k + 1;
        }
        unlock this;
    }

    // merge: multi-conjunct postcondition stresses checkPostSat.
    requires committed(this);
    ensures committed(this) ** \result >= 0 ** \result + 1 > 0 ** \result + 1 >= 1;
    int merge() {
        lock this;
        int total = this.c0 + this.c1 + this.c2 + this.c3 + this.c4 +
                    this.c5 + this.c6 + this.c7 + this.c8 + this.c9 +
                    this.c10 + this.c11 + this.c12 + this.c13 + this.c14;
        unlock this;
        return total;
    }

    requires committed(this);
    ensures committed(this);
    void reset() {
        lock this;
        this.c0 = 0; this.c1 = 0; this.c2 = 0; this.c3 = 0; this.c4 = 0;
        this.c5 = 0; this.c6 = 0; this.c7 = 0; this.c8 = 0; this.c9 = 0;
        this.c10 = 0; this.c11 = 0; this.c12 = 0; this.c13 = 0; this.c14 = 0;
        unlock this;
    }
}

// Top-level pipeline: two par blocks each with 3 independent branches per thread.
// Stresses detectDeadCode in par context + checkPostSat on the outer function.
requires n > 0 && a >= 0 && b >= 0 && c >= 0;
ensures \result >= 0 ** \result + 1 > 0;
int processEvents(int n, int a, int b, int c) {
    par (int tid = 0 .. n) context true; {
        if (tid < a) { int x = tid; } else { int x = 0; }
        if (tid < b) { int y = tid + 1; } else { int y = 0; }
        if (tid < c) { int z = tid + 2; } else { int z = 0; }
    }
    par (int tid2 = 0 .. n) context true; {
        if (a > tid2 && b > tid2) { int p = a - tid2; } else { int p = 0; }
        if (b > tid2 && c > tid2) { int q = b - tid2; } else { int q = 0; }
        if (a > tid2 && c > tid2) { int r = c - tid2; } else { int r = 0; }
    }
    return a + b + c;
}
