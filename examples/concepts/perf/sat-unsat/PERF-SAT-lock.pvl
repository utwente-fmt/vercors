//:: cases PERF_SAT_lock
//:: tools silicon
//:: verdict Pass

// Sat/unsat pair D (lock): satisfiable lock invariant — checkLockInvSat must not fire.
// Pair with PERF-UNSAT-lock.
lock_invariant Perm(value, write) ** value >= 0;
class PERF_SAT_lock {
    int value;
    ensures committed(this); constructor() { value = 0; commit this; }
    requires committed(this); void work() { lock this; value = value + 1; unlock this; }
}
