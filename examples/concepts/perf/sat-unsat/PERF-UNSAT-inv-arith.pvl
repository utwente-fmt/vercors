//:: cases PERF_UNSAT_inv_arith
//:: tools silicon
//:: verdict Fail

// Sat/unsat pair A (arithmetic): unsatisfiable invariant — must fire.
// Pair with PERF-SAT-inv-arith.
requires n >= 0;
void perf_unsat_inv_arith(int n) {
    int i = 0;
    loop_invariant i > 0 && i < 0;
    while (i < n) { i = i + 1; }
}
