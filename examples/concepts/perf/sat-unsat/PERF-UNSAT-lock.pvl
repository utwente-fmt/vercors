//:: cases PERF_UNSAT_lock
//:: tools silicon
//:: verdict Fail

// Sat/unsat pair D (lock): unsatisfiable lock invariant — lockInvariantUnsatisfiable must fire.
// Perm is consistent but value > 5 && value < 3 is a contradiction.
lock_invariant Perm(value, write) ** (value > 5 && value < 3);
class PERF_UNSAT_lock {
    int value;
    ensures committed(this); constructor() { value = 0; commit this; }
    requires committed(this); void work() { lock this; value = value + 1; unlock this; }
}
