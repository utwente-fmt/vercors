//:: cases PERF_SAT_inv_arith
//:: tools silicon
//:: verdict Pass

// Sat/unsat pair A (arithmetic): satisfiable invariant — checkInvSat must not fire.
// Pair with PERF-UNSAT-inv-arith: same structure, only the formula differs.
requires n >= 0;
void perf_sat_inv_arith(int n) {
    int i = 0;
    loop_invariant i >= 0 && i <= n;
    while (i < n) { i = i + 1; }
}
