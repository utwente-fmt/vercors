//:: cases PERF_UNSAT_inv_perm
//:: tools silicon
//:: verdict Fail

// Sat/unsat pair B (permission): unsatisfiable permission invariant — invariantUnsatisfiable must fire.
// Perm is inhaled (consistent) but value > 0 && value < 0 is a contradiction.
class PERF_UNSAT_inv_perm_Node {
    int value;

    requires Perm(this.value, write);
    void run(int n) {
        loop_invariant Perm(this.value, write) ** this.value > 0 && this.value < 0;
        while (this.value < n) { this.value = this.value + 1; }
    }
}
