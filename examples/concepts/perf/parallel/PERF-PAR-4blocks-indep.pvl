// 4 par blocks, each an indep-5-style body (PERF-BRANCH-indep-5, 279 traces).
// Tests whether par blocks multiply the trace count per block or cap it.
requires n > 0 && v1 > -1000 && v2 > -1000 && v3 > -1000 && v4 > -1000 && v5 > -1000;
void perf_par_4blocks_indep(int n, int v1, int v2, int v3, int v4, int v5) {
    par (int tid1 = 0 .. n)
        context true;
    {
        if (v1 > 0) { int r1 = v1; }
        if (v2 > 0) { int r2 = v2; }
        if (v3 > 0) { int r3 = v3; }
        if (v4 > 0) { int r4 = v4; }
        if (v5 > 0) { int r5 = v5; }
    }
    par (int tid2 = 0 .. n)
        context true;
    {
        if (v1 > 0) { int r1 = v1; }
        if (v2 > 0) { int r2 = v2; }
        if (v3 > 0) { int r3 = v3; }
        if (v4 > 0) { int r4 = v4; }
        if (v5 > 0) { int r5 = v5; }
    }
    par (int tid3 = 0 .. n)
        context true;
    {
        if (v1 > 0) { int r1 = v1; }
        if (v2 > 0) { int r2 = v2; }
        if (v3 > 0) { int r3 = v3; }
        if (v4 > 0) { int r4 = v4; }
        if (v5 > 0) { int r5 = v5; }
    }
    par (int tid4 = 0 .. n)
        context true;
    {
        if (v1 > 0) { int r1 = v1; }
        if (v2 > 0) { int r2 = v2; }
        if (v3 > 0) { int r3 = v3; }
        if (v4 > 0) { int r4 = v4; }
        if (v5 > 0) { int r5 = v5; }
    }
}
