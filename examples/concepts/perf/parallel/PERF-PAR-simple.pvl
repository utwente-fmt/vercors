//:: cases PERF_PAR_simple
//:: tools silicon
//:: verdict Pass

// Performance: single parallel block with multi-variable branch conditions and non-empty bodies.
// detectDeadCode: par block body Refute + branch arm Refutes; conditions involve (a, b) jointly.
// Compare to PERF-BRANCH-5: same branch structure but inside a parallel context.
requires n > 0 && a >= 0 && b >= 0;
void perf_par_simple(int n, int a, int b) {
    par (int tid = 0 .. n)
        context true;
    {
        if (a + b > 100) { int s = a + b - 100; } else { int s = 100 - a - b; }
        if (a > b + 20) { int t = a - b - 20; } else { int t = b - a; }
        if (a > 50 && b > 50) { int u = a + b; } else { int u = 0; }
    }
}
