//:: cases PERF_PAR_4blocks
//:: tools silicon
//:: verdict Pass

// Performance: 4 sequential parallel blocks, each with live branches inside.
// detectDeadCode instruments each par block body separately.
// Compare to PERF-BRANCH-5: same number of branches but split across parallel contexts.
requires n > 0 && m > 0;
void perf_par_4blocks(int n, int m, int x) {
    par (int tid = 0 .. n)
        context true;
    {
        if (x > 0) { }
        if (x <= 0) { }
    }
    par (int tid2 = 0 .. m)
        context true;
    {
        if (x > 0) { }
        if (x <= 0) { }
    }
    par (int tid3 = 0 .. n)
        context true;
    {
        if (x > 0) { }
        if (x <= 0) { }
    }
    par (int tid4 = 0 .. m)
        context true;
    {
        if (x > 0) { }
        if (x <= 0) { }
    }
}
