// NB: \old does not work in the postcondition of run methods. This file works around this
// by manually maintaining the required previous state in an auxiliary field.

class Point {
  int x;
  int y;
}

class X {
  Point p;

  int old_x;
  
  requires Perm(this.p, 1\3) ** Perm(this.p.x, 1) ** Perm(old_x, read) ** old_x == this.p.x;
  ensures Perm(old_x, read);
  ensures Perm(this.p, 1\3) ** PointsTo(this.p.x, 1, old_x + 1);
  run {
    Point q = this.p;
    q.x = q.x + 1;
  }
}

class Y {
  Point p;
  int old_y;

  requires Perm(this.p, 1\3) ** Perm(this.p.y, 1) ** Perm(old_y, read) ** old_y == this.p.y;
  ensures Perm(old_y, read);
  ensures Perm(this.p, 1\3) ** PointsTo(this.p.y, 1, old_y + 1);
  run {
    Point q = this.p;
    q.y = q.y + 1;
  }
}

void main(){
  Point p = new Point();
  p.x = 2;
  p.y = 6;

  X obj1 = new X();
  obj1.p = p;
  // Save old state
  obj1.old_x = p.x;
  fork obj1;
  
  Y obj2 = new Y();
  obj2.p = p;
  // Save old state
  obj2.old_y = p.y;
  fork obj2;

  join obj1;
  join obj2;

  assert PointsTo(p.x, 1, 3) ** PointsTo(p.y, 1, 7);
}

