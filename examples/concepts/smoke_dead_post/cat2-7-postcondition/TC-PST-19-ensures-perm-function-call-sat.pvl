//:: cases TC_PST_19_EnsuresPermFunctionCallSat
//:: tools silicon
//:: verdict Pass

// TC-PST-19: Postcondition calls a pure function that requires read permission on a field.
// foo explicitly ensures Perm(n.value, write), so the permission is part of the
// postcondition expression that gets inhaled in the postSat check.
// Check: inhale Perm(n.value, write) ** isFieldPos(n)
// isFieldPos axiom fires (Perm present): isFieldPos(n) == (n.value > 0) — satisfiable.
// postUnsatisfiable must not fire.
// Normal verification also passes: precondition grants permission and n.value > 0.

class TC_PST_19_Node {
    int value;
}

requires Perm(n.value, write);
pure boolean isFieldPos(TC_PST_19_Node n) = n.value > 0 || n.value < 0;

requires Perm(n.value, write) ** n.value > 0;
ensures Perm(n.value, write) ** isFieldPos(n);
void foo(TC_PST_19_Node n) { }

