//:: cases TC_PST_20_EnsuresPermFunctionCallUnsat
//:: tools silicon
//:: verdict Fail

// TC-PST-20: Postcondition calls a pure function that requires read permission and is always false.
// isFieldFalse has precondition Perm(n.value, read) — its axiom fires when Perm is present.
// foo ensures Perm(n.value, read) ** isFieldFalse(n), so the postSat check inhales that.
// With Perm present, axiom fires: isFieldFalse(n) == (n.value > 0 && n.value < 0) — always
// false (no value is simultaneously > 0 and < 0) — contradiction — postUnsatisfiable fires.

class TC_PST_20_Node {
    int value;
}

requires Perm(n.value, read);
pure boolean isFieldFalse(TC_PST_20_Node n) = n.value > 0 && n.value < 0;


ensures Perm(n.value, read) ** isFieldFalse(n);
void foo(TC_PST_20_Node n) { }
