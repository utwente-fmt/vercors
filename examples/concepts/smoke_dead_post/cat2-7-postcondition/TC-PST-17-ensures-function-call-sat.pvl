//:: cases TC_PST_17_EnsuresFunctionCallSat
//:: tools silicon
//:: verdict Pass

// TC-PST-17: Postcondition calls a pure function whose precondition matches foo's.
// foo requires n > 10 — supervisor's fix inhales n > 10, which satisfies checkPos's
// precondition and unlocks the axiom: checkPos(n) == (n > 10) == true.
// Satisfiable — postUnsatisfiable must not fire.
// Normal verification also passes: n > 10 establishes checkPos(n).

requires x > 10;
pure boolean checkPos(int x) = x > 10;

requires n > 10;
ensures checkPos(n);
void foo(int n) { }
