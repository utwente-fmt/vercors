//:: cases TC_PST_22_NestedFunctionCallsSat
//:: tools silicon
//:: verdict Pass

// TC-PST-22: Postcondition contains a nested call isLargeEnough(increment(n)).
// Both helpers have no preconditions, so their axioms fire unconditionally.
// increment(n) = n + 1. foo requires n > 0 => n + 1 > 1.
// isLargeEnough(n + 1) = (n + 1 > 1) = true — satisfiable.
// postUnsatisfiable must not fire.
// Normal verification also passes: isLargeEnough(increment(n)) = n+1>1, which holds for n>0.

pure int increment(int n) = n + 1;

pure boolean isLargeEnough(int x) = x > 1;

requires n > 0;
ensures isLargeEnough(increment(n));
void foo(int n) { }
