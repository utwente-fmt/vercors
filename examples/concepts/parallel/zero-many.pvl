class ZeroMany {
  context_everywhere matrix != null && M>=0 && N>=0;
	context_everywhere \matrix(matrix, M, N);
  context (\forall* int i ; 0 <= i && i < M ;
            (\forall* int j ; 0 <= j && j < N ;
              Perm(matrix[i][j], write)));
  ensures (\forall int i ; 0 <= i && i < M ;
            (\forall int j ; 0 <= j && j < N ;
              matrix[i][j] == 0));
  void initialise(int M, int N, int[M][N] matrix){
    par (int i = 0 .. M, int j = 0 .. N)
      context Perm(matrix[i][j], write);
      ensures matrix[i][j] == 0;
    {
      matrix[i][j] = 0;
    }
  }
}


