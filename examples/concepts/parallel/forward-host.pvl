class Ref {

    context_everywhere N>0 && a != null && b != null && c != null;
    context_everywhere a.length == b.length && b.length == c.length && c.length == N;
    context  (∀* int i=0..N; Perm(a[i],write));
    context  (∀* int i=0..N; Perm(b[i],1\2));
    context  (∀* int i=0..N; Perm(c[i],write));
    requires (∀  int i=0..N; b [ i ] == i);
    ensures  (∀  int i=0..N;  a[i] == i+1);
    ensures  (∀  int i=0..N;  b[i] == i  );
    ensures  (∀  int i=0..N; 0 < i ==> c[i] == i+2);

  void forward(int N,int[] a,int[] b, int[] c){
    par fwd (int i=0..N)
      requires Perm(a[i],write);
      ensures  i>0 ==> Perm(a[i-1],1\2);
      ensures i==N-1 ? Perm(a[i],write) : Perm(a[i], 1\2);
      context Perm(b[i],1\2);
      context Perm(c[i],write);
      
      ensures a[i]==i+1;      
      context b[i]==i;
      ensures b[i]==i;
      ensures i>0 ==> c[i]==i+2;
    {
      a[i]=b[i]+1;
      barrier(fwd){
        requires i < N-1 ==> Perm(a[i],1\2);
        requires i < N-1 ==> a[i]==i+1;
        ensures  i > 0   ==> Perm(a[i-1],1\2);
        ensures  i > 0   ==> a[i-1]==i;
      }
      if (i>0) {
        c[i]=a[i-1]+2;
      }
    }
  }

 
  context_everywhere N>10 && a != null && b != null && c != null;
  context_everywhere a.length == b.length && b.length == c.length && c.length == N;
  requires (∀* int i=0..N; Perm(a[i],write));
  requires (∀* int i=0..N; Perm(b[i],write));
  requires (∀* int i=0..N; Perm(c[i],write));
  void host(int N,int[N] a,int[N] b, int[N] c){
    par(int i=0..N)
      requires Perm(b[i],write);
      ensures  Perm(b[i],write) ** b[i]==i;
    {
      b[i]=i;
    }

    forward(N,a,b,c);
    
    assert a[5]==6;
    assert c[5]==6; // <- not true.
  }

}

