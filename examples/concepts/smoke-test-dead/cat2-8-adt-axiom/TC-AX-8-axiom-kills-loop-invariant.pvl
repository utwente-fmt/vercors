//:: cases TC_AX_8_AxiomKillsLoopInvariant
//:: tools silicon
//:: verdict Fail

// TC-AX-8: loop_invariant Foo.f() < 0 directly contradicts axiom f() > 100.
// No state can satisfy the invariant — CheckLoopInvariantSatisfiability should
// detect it as unsatisfiable, analogous to TC-AX-2 for preconditions.
adt Foo {
    pure int f();
    axiom (f() > 100);
}

void method(int x) {
    loop_invariant Foo.f() < 0; // contradicts axiom: f() > 100 makes this impossible
    while (x > 0) {
        x = x - 1;
    }
}
