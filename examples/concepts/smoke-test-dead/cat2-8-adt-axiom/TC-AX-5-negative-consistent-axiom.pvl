//:: cases TC_AX_5_NegativeConsistentAxiom
//:: tools silicon
//:: verdict Pass

// TC-AX-5 (Negative): Axiom f() > 0 does not kill either branch.
// Both f() > 5 (e.g. f()=6) and f() <= 5 (e.g. f()=1) are possible under the axiom.
// No dead code warning expected — false-positive baseline for axiom tests.
adt Foo {
    pure int f();
    axiom (f() > 0);
}

void method() {
    if (Foo.f() > 5) {
        int x = 1; // live: f() could be 6, 7, ...
    } else {
        int x = 2; // live: f() could be 1, 2, ..., 5
    }
}
