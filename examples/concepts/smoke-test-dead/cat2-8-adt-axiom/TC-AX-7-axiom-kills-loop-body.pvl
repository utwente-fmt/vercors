//:: cases TC_AX_7_AxiomKillsLoopBody
//:: tools silicon
//:: verdict Fail

// TC-AX-7: Axiom f() > 100 makes the loop condition f() < 0 impossible.
// The loop body is never entered — DetectDeadCode should fire on the loop body.
adt Foo {
    pure int f();
    axiom (f() > 100);
}

void method() {
    while (Foo.f() < 0) {
        int x = 1; // dead: axiom guarantees f() > 100, so f() < 0 never holds
    }
}
