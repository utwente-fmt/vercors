//:: cases TC_LK_8_ValidProgramNegative
//:: tools silicon
//:: verdict Pass  // Correct: satisfiable invariant, well-written program, no dead code

// TC-LK-8 (Negative): A complete valid concurrent class.
// Constructor commits the object; methods acquire and release the lock correctly.
// Verifies no false positives from any of the three new checks:
//
//   CheckLockInvariantSatisfiability FramedProof:
//     Inhale(Perm(count,write) ** count>=0); Refute(ff)
//     count=0 satisfies count>=0 → Refute FAILS → expected error tripped → no lockInvUnsat ✓
//
//   EncodeIntrinsicLock lock Refute(ff)(LockDeadCodeBlame):
//     After unfold: Perm(count,write) ** count>=0 — consistent → no lockDead ✓
//
//   EncodeIntrinsicLock unlock Refute(ff)(UnlockDeadCodeBlame):
//     After fold + exhale: invariant re-established — consistent → no unlockDead ✓
lock_invariant Perm(count, write) ** count >= 0;
class Counter {
    int count;

    ensures committed(this);
    constructor() {
        count = 0;
        commit this;
    }

    context committed(this);
    void increment() {
        lock this;
        // count >= 0 from invariant; count + 1 >= 1 >= 0 — invariant preserved.
        count = count + 1;
        unlock this;
    }

    context committed(this);
    void decrement() {
        lock this;
        if (count > 0) {
            // count > 0, so count - 1 >= 0 — invariant preserved.
            count = count - 1;
        }
        // If count == 0 we do nothing; invariant trivially preserved.
        unlock this;
    }
}
