//:: cases TC_LK_7_NoInvariantNegative
//:: tools silicon
//:: verdict Pass  // Correct: no lock invariant → no dead-code errors

// TC-LK-7 (Negative): No lock_invariant means intrinsicLockInvariant = tt.
//
// CheckLockInvariantSatisfiability skips classes with trivial invariants:
//   cls.intrinsicLockInvariant == tt[Pre]  →  lock.rewriteDefault()
// No FramedProof is inserted; no lockInvariantUnsatisfiable can fire.
//
// EncodeIntrinsicLock's no-invariant lock expansion:
//   assert committed(this)
//   {lockHeld} inhale Perm(held, write)   ← tagged → DetectDeadCode SKIPS
//   Refute(ff)(LockDeadCodeBlame)         ← state always live → no-op ✓
//
// EncodeIntrinsicLock's unlock expansion:
//   exhale Perm(held, write)
//   Refute(ff)(UnlockDeadCodeBlame)       ← state always live → no-op ✓
//   {lockCommitted} assume committed      ← tagged → DetectDeadCode SKIPS
//
// All three Refutes fire in a live state: assert false FAILS → expected error
// IS tripped → no error reported.  No false positives anywhere.
class NoInvClass {
    requires committed(this);
    void method() {
        lock this;
        // State: just held(this).  No invariant resources.  Always live.
        unlock this;
        // State: live.  No dead code reported.
    }
}
