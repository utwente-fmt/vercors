//:: cases TC_CB_7_ExhaleFalse
//:: tools silicon
//:: verdict Fail

// TC-CB-7: Pathological edge case — exhale false.
// exhale checks that the resource holds and removes it from the state.
// Since false never holds, exhale false always fails with an exhale error.
// Verdict is Fail due to the exhale failure, NOT dead code detection.
// Unlike assume/inhale false, exhale does not make subsequent code dead —
// it fails at the exhale point and does not narrow the path condition.
void f(int x) {
    exhale false; // exhale failure: false never holds as a resource
    if (x > 0) {
        x = x + 1; // NOT dead from exhale's perspective
    }
}
