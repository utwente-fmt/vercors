//:: cases TC_PC_1_NullCheck
//:: tools silicon
//:: verdict Fail

// TC-PC-1: Motivating example from Frama-C WP smoke test paper.
// requires p != null makes the null check inside the method dead.
// This is the canonical case of specification-induced dead code.
class Box { int val; }

requires p != null;
void read1(Box p) {
    if (p == null) {
        int x  = 1; // dead: null check after non-null precondition
        return;
    }
}
