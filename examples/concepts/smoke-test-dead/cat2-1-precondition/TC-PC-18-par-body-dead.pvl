//:: cases TC_PC_18_ParBodyDead
//:: tools silicon
//:: verdict Fail

// TC-PC-18: Par block body is dead because requires size <= 0 makes the
// range  empty — no valid tid exists, so the body is unreachable.
requires size <= 0;
void f(int size) {
    par (int tid = 0 .. size)
    {
        return; // dead: 0 <= tid < size <= 0 is inconsistent
    }
}
