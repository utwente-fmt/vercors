//:: cases TC_PC_17_ParallelDeadBranch
//:: tools silicon
//:: verdict Fail

// TC-PC-17: Parallel block — tid is in range, so tid < 0 is dead.
// tid >= 0 is live. Expected: warning on first branch only.
requires size > 0;
void f(int size) {
    par (int tid = 0 .. size)
        context 0 < size;
    {
        if (tid < 0) {
            return; // dead
        }
        if (tid >= 0) {
            return; // live: tid is always >= 0
        }
    }
    //PROBLEM: both ifs are dead, even second one
}
