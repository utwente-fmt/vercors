//:: cases TC_PC_18_AtomicDeadBranch
//:: tools silicon
//:: verdict Fail

// TC-PC-18: Atomic block — the atomic invariant (x > 0) is assumed inside
// the atomic block. Branch x < 0 is dead there. Branch x > 0 is live.
// Expected: warning on first branch only.
requires x > 0;
void f(int x) {
    invariant inv (x > 0) {
        atomic (inv) {
            if (x > 0) {
                return; // dead
            }
            if (x < 0) {
                return; // live
            }
        }
    }
}
