//:: cases TC_PC_11_NestedInnerDead
//:: tools silicon
//:: verdict Fail

// TC-PC-11: Nested branches — outer is live, inner is dead.
// Tests that the pass correctly enters a live outer branch and
// detects a dead inner branch inside it.
requires x > 0;
void f(int x) {
    if (x > 0) { // live: precondition implies x > 0
        if (x < 0) {
            x = x + 1; // dead: x > 0 AND x < 0 inside live outer branch
        }
    }
}
