//:: cases TC_PC_16_ForBodyLive
//:: tools silicon
//:: verdict Pass

// TC-PC-16 (Negative): For loop body is live — requires x > 0 means the
// loop runs at least once (i starts at 0, condition i < x is true).
requires x > 0;
void f(int x) {
    loop_invariant i >= x;
    for (int i = 0; i < x; i = i + 1) {
        x = x + 1; // live: x > 0 so loop runs at least once
    }
}
