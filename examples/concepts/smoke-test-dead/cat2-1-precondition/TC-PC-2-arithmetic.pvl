//:: cases TC_PC_2_Arithmetic
//:: tools silicon
//:: verdict Fail

// TC-PC-2: Arithmetic contradiction between precondition and branch condition.
// requires x > 0 makes x < 0 impossible — the then-branch is dead.
requires x > 0;
void f(int x) {
    if (x < 0) {
        x = x + 1; // dead: x > 0 AND x < 0 unsatisfiable
    }
}
