//:: cases TC_PC_3_ElseDead
//:: tools silicon
//:: verdict Fail

// TC-PC-3: Precondition implies the branch condition is always true,
// making the else-branch dead. Then-branch is live.
requires x > 0;
void f(int x) {
    if (x > 0) {
        x = x + 1; // live: precondition implies x > 0
    } else {
        x = x + 2; // dead: precondition implies the condition, so else unreachable
    }
}
