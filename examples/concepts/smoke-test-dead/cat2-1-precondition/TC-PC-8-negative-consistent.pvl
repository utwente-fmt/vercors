//:: cases TC_PC_8_NegativeConsistent
//:: tools silicon
//:: verdict Pass

// TC-PC-8 (Negative): Precondition is consistent with both branches.
// requires x > 0 allows x in {1,2,...} — both x > 5 and x <= 5 are possible.
// No dead code warning expected on either branch.
requires x > 0;
void f(int x) {
    if (x > 5) {
        x = x + 1; // live: x could be 6, 7, ...
    } else {
        x = x + 1; // live: x could be 1, 2, ..., 5
    }
}
