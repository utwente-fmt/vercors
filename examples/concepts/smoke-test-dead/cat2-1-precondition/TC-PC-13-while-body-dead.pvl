//:: cases TC_PC_13_WhileBodyDead
//:: tools silicon
//:: verdict Fail

// TC-PC-13: While loop body is dead — precondition contradicts loop condition.
// requires x > 0 means x < 0 can never be true, so the loop body is unreachable.
requires x > 0;
void f(int x) {
    loop_invariant x > 0;
    while (x < 0) {
        return; // dead: x > 0 contradicts loop condition x < 0
    }
    x = x + 1;
}
