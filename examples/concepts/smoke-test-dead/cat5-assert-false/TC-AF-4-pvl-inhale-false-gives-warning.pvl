//:: cases TC_AF_4_PvlInhaleFalseGivesWarning
//:: tools silicon
//:: verdict Fail

// TC-AF-4 (PVL): inhale false mid-block. DetectDeadCode emits a DeadBranch warning
// at rewrite time. Unlike assert false, inhale false is NOT a dead code marker —
// no block cutoff applies. Code after it is still instrumented; Silicon's state is ⊥
// after inhale false, so the Refute(false) check for the if-branch fires.
//
// Expected errors: 2 (deadBranch for inhale false + deadBranch for then-branch).
void f(int x) {
    x = x + 1;
    inhale false;        // DeadBranch warning; code after still instrumented
    if (x > 0) {         // instrumented — Refute(false) fires (state is ⊥)
        x = x - 1;
    }
}
