// The assert false itself fails (assertFailed) because the path is still live here.
// The if and while after assert false are NOT checked for reachability (block cutoff).
//
// Expected errors: 1 (assertFailed from assert false).
requires x > 0;
void f(int x) {
    x = x + 1;
    if(x<0){
        assert false;              // assertFailed — block cutoff starts here
        if (x == 2) {              // not instrumented (block cutoff)
            x = x - 1;
        }
        loop_invariant x > 0;
        while (x > 1) {            // not instrumented (block cutoff)
            x = x - 1;
        }
        x = x + 2;

    }
}
