//:: cases TC_AF_2_PvlAssertFalseInLoopBody
//:: tools silicon
//:: verdict Fail

// TC-AF-2 (PVL): assert false inside a loop body — block cutoff within the body block.
// The loop body Refute check passes (loop condition x < 10 is satisfiable).
// Inside the body, assert false triggers block cutoff: the if (x > 5) after it
// is NOT instrumented. The assert false itself fails (assertFailed).
//
// Expected errors: 1 (assertFailed from assert false in body).
void f(int x) {
    loop_invariant true;
    while (x < 10) {
        x = x + 1;
        assert false;    // assertFailed — block cutoff within body
        if (x > 5) {     // not instrumented (block cutoff)
            x = 0;
        }
    }
}
