//:: cases TC_AS_6_GhostAssume
//:: tools silicon
//:: verdict Fail

// TC-AS-6: Ghost assume — ghost code is erased to regular COL nodes before
// the dead code pass runs. A ghost assume is indistinguishable from a
// regular assume by the time DetectDeadCode executes.
// This test verifies ghost assumes narrow the state identically to regular assumes.
void f(int x) {
    ghost assume x > 0; // ghost assume: stripped to regular Assume(x > 0) in COL
    if (x < 0) {
        x = x + 1; // dead: ghost assume applies to the state
    }
}
