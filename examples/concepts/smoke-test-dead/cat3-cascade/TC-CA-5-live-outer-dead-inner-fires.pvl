//:: cases TC_CA_5_LiveOuterDeadInnerFires
//:: tools silicon
//:: verdict Fail

// TC-CA-5: Live outer branch — dead inner branch fires independently.
//
// The outer if (x > 0) is live (precondition x > 0 satisfies it).
// outerBlame's refute false does NOT fire — outerBlame.didFire stays false.
//
// The inner if (x < 0) is dead: inside the live outer body, state = {x > 0, x > 0}
// which still contradicts x < 0.
// innerBlame's ancestorFired = () => outerBlame.didFire = false → fires, reports deadBranch.
//
// A live outer branch does NOT suppress its inner dead branches.
//
// Expected errors: 1 (inner dead branch). Outer is live, not suppressed, not suppressing.
requires x > 0;
void f(int x) {
    if (x > 0) { // live outer — outerBlame does not fire
        if (x < 0) { // dead inner — fires because ancestorFired = false
            x = x + 1;
        }
        x = x - 1;
    }
}
