//:: cases TC_CA_11_InvNotMaintainedDoesNotSuppress
//:: tools silicon
//:: verdict Fail

// TC-CA-11: invariantNotMaintained does NOT suppress — body is live, inner dead branch fires.
//
// Invariant x > 0 is established (requires x > 0).  The body x = x - 1 can break
// the invariant when x = 1 (giving x - 1 = 0), so invariantNotMaintained fires.
// However, invNotEstablishedFired stays false — only LoopInvariantNotEstablished
// triggers the suppressor, not LoopInvariantNotMaintained.
//
// The body itself is LIVE: invariant x > 0 AND condition x < 10 is satisfiable
// (e.g. x = 5), so the body's Refute(ff) does not fire.
//
// After x = x - 1 inside the body: x_new = x_old - 1 >= 0 (since x_old > 0 implies
// x_old >= 1).  Branch x < 0 is therefore dead — its Refute(ff) fires.
// ancestorFiredFn = () => bodyBlame.didFire = false (body was live), so
// the inner deadBranch is NOT suppressed and IS reported.
//
// Expected errors: 2 (invariantNotMaintained + deadBranch for inner if).
// Body deadBranch: does not fire (body is live). Suppressor: never activated.
requires x > 0;
void f(int x) {
    loop_invariant x > 0;
    while (x < 10) {
        x = x - 1;   // invariantNotMaintained: x-1 may be 0 (when x=1), violating x > 0
        if (x < 0) { // dead: after decrement x >= 0 (since x_old >= 1), x < 0 impossible
            x = x + 5;
        }
    }
}
