//:: cases TC_CA_4_SequentialIndependentBothFire
//:: tools silicon
//:: verdict Fail

// TC-CA-4: Two sequential dead branches — cascade does NOT suppress them.
//
// Cascade suppression only applies to NESTED blames (inner branch inside a dead
// outer branch body).  Sequential branches at the same level have independent
// blames with no ancestor relationship, so both fire.
//
// requires x > 0 makes both x < 0 and x < -5 unreachable.
//
// Expected errors: 2 (one per branch). Neither suppresses the other.
requires x > 0;
void f(int x) {
    if (x < 0) { // dead branch 1 — fires (blame1, no ancestor)
        x = x + 1;
    }
    if (x < -5) { // dead branch 2 — fires independently (blame2, no ancestor)
        x = x - 1;
    }
}
