//:: cases TC_CA_8_NegativeAllLive
//:: tools silicon
//:: verdict Pass

// TC-CA-8 (Negative): All branches are live — no cascade, no warnings.
//
// requires x > 0 leaves x > 5, x < 100, and the loop x < 10 all potentially
// reachable.  No refute false fires.  This is the baseline that confirms the
// cascade tests are not vacuously passing.
//
// Expected: Pass — no deadBranch warnings.
requires x > 0;
void f(int x) {
    if (x > 5) {    // live: x could be 6,7,...
        x = x - 1;
    }
    if (x < 100) {  // live: x > 0 allows x < 100
        x = x + 1;
    }
    if (x > 0) {    // live: matches precondition
        if (x < 50) { // live: x could be 1..49
            x = x + 2;
        }
    }
}
