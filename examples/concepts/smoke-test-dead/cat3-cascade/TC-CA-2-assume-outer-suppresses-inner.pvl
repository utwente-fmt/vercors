//:: cases TC_CA_2_AssumeOuterSuppressesInner
//:: tools silicon
//:: verdict Fail

// TC-CA-2: assume false — cascade suppression via post-assume check.
//
// assume false immediately makes the state contradictory.  The post-assume
// refute false fires (deadBranch: "code after assume false").
//
// The outer if (x > 0) also fires independently — it is inside the dead state,
// but its blame has no ancestor (the post-assume blame is sequential, not nested).
//
// Cascade: the inner if (x == 1) is inside the outer if body.  Its blame
// captures () => outerIfBlame.didFire.  The outer if blame fires first, so
// the inner if blame is SUPPRESSED.
//
// Expected errors: 2 (post-assume + outer if). Inner if: suppressed.
void f(int x) {
    assume false; // post-assume check fires — state immediately contradictory
    if (x > 0) { // outer dead — fires independently
        if (x == 1) { // inner dead — suppressed by outer if blame
            x = x + 1;
        }
        x = x - 1;
    }
}
