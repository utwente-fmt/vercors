//:: cases TC_CM_1_PreconditionAssume
//:: tools silicon
//:: verdict Fail

// TC-CM-1: Precondition + assume together make a branch dead.
// requires x > 0 AND assume x < 10 narrows to (0, 10).
// Branch x > 20 is impossible in that range.
requires x > 0;
void f(int x) {
    assume x < 10;
    if (x > 20) {
        refute false; // dead: x in (0,10) but x > 20 impossible
    }
}
