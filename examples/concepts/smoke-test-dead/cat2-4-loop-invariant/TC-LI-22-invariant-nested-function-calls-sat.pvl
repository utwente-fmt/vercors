//:: cases TC_LI_22_InvariantNestedFunctionCallsSat
//:: tools silicon
//:: verdict Pass

// TC-LI-22: Loop invariant contains a nested call isLargeEnough(increment(x)).
// Same depth-first WD collection as TC-PST-22 but for the FramedProof+Inhale pattern:
//   WD: [x > 0 (from increment), increment(x) > 1 (from isLargeEnough)]
// FramedProof: inhale x > 0 ** increment(x) > 1 ** isLargeEnough(increment(x))
// Satisfiable (x=1: increment(1)=2>1, isLargeEnough(2)=true) -> invSat must not fire.
// Normal verification also passes: precondition x > 0 establishes the invariant,
// and incrementing x preserves it since increment(x_new) = x_new+1 > 1 as x_new > 0.

requires n > 0;
pure int increment(int n) = n + 1;

requires x > 1;
pure boolean isLargeEnough(int x) = x > 1;

requires x > 0;
void foo(int x) {
    loop_invariant isLargeEnough(increment(x));
    while (x < 100) { x = x + 1; }
}
