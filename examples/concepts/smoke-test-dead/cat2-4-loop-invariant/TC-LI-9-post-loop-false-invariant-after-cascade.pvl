//:: tools silicon
//:: verdict Fail

// TC-LI-9: loop_invariant false — both the sat check and the loop itself fire.
// invariantUnsatisfiable fires from the sat check (IndetBranch before the loop).
// invariantNotEstablished fires from the loop itself.
// Both the body deadBranch and the post-loop deadBranch are suppressed as cascades.
//
// Expected errors: 2 (invariantUnsatisfiable + invariantNotEstablished).
// Body deadBranch: SUPPRESSED. Post-loop deadBranch: SUPPRESSED.
void f(int x) {
    loop_invariant false;
    while (x > 0) {
        x = x - 1; // body deadBranch suppressed (cascading from invariantNotEstablished)
    }
    int dead = x; // post-loop also suppressed — all cascade from invariantNotEstablished
}
