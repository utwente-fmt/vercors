//:: cases TC_LI_20_InvariantFunctionCallSat
//:: tools silicon
//:: verdict Pass

// TC-LI-20: Loop invariant calls a pure function with precondition x >= 0.
// checkInvSat must inhale the WD condition (x >= 0) in a separate Inhale BEFORE
// inhaling nonNeg(x), so the precondition is in state when nonNeg's WD is checked.
// The satisfiability check must not fire: x = 0 satisfies both invariants.
// Normal verification: x >= 0 is listed first so Silicon can re-assume it after
// havocing x, making nonNeg(x)'s precondition provable without circular dependency.

requires x >= 0;
pure boolean nonNeg(int x) = x >= 0;

requires x >= 0;
void foo(int x) {
    loop_invariant x >= 0;
    loop_invariant nonNeg(x);
    while (x > 0) {
        x = x - 1;
    }
}
