//:: cases TC_LI_6_PostLoopSequentialDead
//:: tools silicon
//:: verdict Fail

// TC-LI-6: Invariant x > 0 combined with exit condition !(x > 0) makes the
// post-loop state false (x > 0 AND x <= 0 = false).
// DetectDeadCode adds Refute(false) after every loop; it fires here because
// the verifier can prove false in the post-loop context.
//
// Expected errors: 1 (deadBranch for code after loop).
// invNotEstablishedFired: stays false — invariant is established by requires x > 0.
requires x > 0;
void f(int x) {
    loop_invariant x > 0;
    while (x > 0) {
        x = x + 1; // maintains invariant; loop never exits
    }
    // post-loop state: x > 0 (invariant) AND !(x > 0) (exit) = false
    int dead = x; // DEAD — detected via post-loop Refute(false)
}
