//:: cases TC_LI_8_PostLoopContextEverywhereDead
//:: tools silicon
//:: verdict Fail

// TC-LI-8: context_everywhere propagates x > 10 into the loop invariant
// (via PropagateContextEverywhere). This makes the invariant x > 10, which is
// stronger than condition x > 0. Post-loop state: x > 10 AND x <= 0 = false.
// DetectDeadCode's post-loop Refute(false) fires on the unsatisfiable exit state.
//
// Expected errors: 1 (deadBranch for code after loop).
// invNotEstablishedFired: stays false — context_everywhere invariant is established.
requires x > 10;
void f(int x) {
    context_everywhere x > 10;
    while (x > 0) {
        x = x + 1; // context_everywhere invariant x > 10 maintained; loop never exits
    }
    // post-loop state: (context_everywhere x > 10) AND !(x > 0) = false
    int dead = x; // DEAD — detected via post-loop Refute(false)
}
