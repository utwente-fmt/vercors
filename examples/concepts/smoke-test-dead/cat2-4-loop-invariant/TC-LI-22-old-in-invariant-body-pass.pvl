//:: cases TC_LI_22_OldInInvariantBodyPass
//:: tools silicon
//:: verdict Pass

// TC-LI-22: Loop invariant contains \old(e) in the body (not in a trigger).
// \old(n) refers to n at method entry. The invariant i >= 0 && n == \old(n)
// is satisfiable (e.g. i=0, n=5). Sat check must NOT fire.
requires n >= 0;
void f(int n) {
    int i = 0;
    loop_invariant i >= 0 && n == \old(n);
    while (i < n) { i = i + 1; }
}
