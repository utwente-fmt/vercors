//:: cases TC_LI_23_InvariantPermFunctionCallSat
//:: tools silicon
//:: verdict Pass

// TC-LI-23: Loop invariant calls a pure function requiring write permission.
// WD fix adds Perm(x.value, write) to the FramedProof inhale so isWritePos(x)
// can be evaluated. The invariant is satisfiable (x.value = 1 witnesses it).
// requires false makes the method body vacuous — only the invSat check fires.

class TC_LI_23_Node {
    int value;
}

requires Perm(n.value, write);
pure boolean isWritePos(TC_LI_23_Node n) = n.value > 0;

requires false;
void foo(TC_LI_23_Node x) {
    loop_invariant isWritePos(x);
    while (true) { }
}
