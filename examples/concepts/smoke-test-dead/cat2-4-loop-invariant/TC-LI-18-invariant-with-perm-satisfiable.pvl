//:: cases TC_LI_18_InvariantWithPermSatisfiable
//:: tools silicon
//:: verdict Pass

// TC-LI-18: loop_invariant with a heap permission and a value constraint is satisfiable.
// The FramedProof context starts with no heap; Inhale grants the permission and establishes
// the value constraint. Refute(false) must succeed — the state is consistent.
// This checks that the invSat check correctly handles resource-based invariants.
class Cell {
    int val;

    requires Perm(this.val, write) ** this.val >= 0;
    void count() {
        loop_invariant Perm(this.val, write) ** this.val >= 0;
        while (this.val < 10) { this.val = this.val + 1; }
    }
}
