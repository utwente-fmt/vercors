//:: cases TC_LI_3_InvariantPreconditionPostLoop
//:: tools silicon
//:: verdict Fail

// TC-LI-3: Combined precondition + loop invariant constrains the post-loop state.
// After loop: invariant (x >= 0) AND exit (x >= 5) AND precondition (x < 10).
// Branch x > 20 is dead (x < 10). Branch x < 0 is dead (invariant says x >= 0).
requires x > 0;
requires x < 10;
void f(int x) {
    loop_invariant x >= 0;
    while (x < 5) { x = x + 1; }
    if (x > 20) {
        refute false; // dead: precondition x < 10 rules this out
    }
    if (x < 0) {
        refute false; // dead: loop invariant x >= 0 rules this out
    }
}
