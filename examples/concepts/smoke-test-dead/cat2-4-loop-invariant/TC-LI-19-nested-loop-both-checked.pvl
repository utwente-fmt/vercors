//:: cases TC_LI_19_NestedLoopBothChecked
//:: tools silicon
//:: verdict Fail

// TC-LI-19: Two nested loops, each with its own loop_invariant.
// The outer invariant is satisfiable (no error).
// The inner invariant (j > 0 && j < 0) is a contradiction — invariantUnsatisfiable fires.
// This verifies that CheckLoopInvariantSatisfiability recurses into loop bodies.
void f(int n) {
    loop_invariant n >= 0;
    while (n > 0) {
        int j = 0;
        loop_invariant j > 0 && j < 0;
        while (j < 5) { j = j + 1; }
        n = n - 1;
    }
}
