//:: cases TC_LI_13_InvariantContradictionUnsat
//:: tools silicon
//:: verdict Fail

// TC-LI-13: loop_invariant x > 0 && x < 0 is a contradiction — no integer satisfies it.
// The sat check fires invariantUnsatisfiable (inhaling the invariant makes the path
// inconsistent, so refute false fails).
// invariantNotEstablished also fires. Cascade dead code is suppressed.
requires true;
void f(int x) {
    loop_invariant x > 0 && x < 0;
    while (x != 0) {
        x = x - 1;
    }
}
