//:: cases TC_LI_25_InvariantPermOvercountBug
//:: tools silicon
//:: verdict Pass

// TC-LI-25: Demonstrates the permission overcounting bug in the WD fix.
// The invariant explicitly includes Perm(x.value, write) AND calls isWritePos(x)
// which also requires Perm(x.value, write).
// WD fix adds Perm(x.value, write) (from isWritePos's precondition).
// Combined inhale:
//   Perm(x.value, write)       <- WD condition
//   ** Perm(x.value, write)    <- from invariant explicitly
//   ** isWritePos(x)
// = 200% write permission = impossible state
// => invariantUnsatisfiable fires INCORRECTLY (verdict should be Pass).

class TC_LI_25_Node {
    int value;
}

requires Perm(n.value, write);
pure boolean isWritePos(TC_LI_25_Node n) = n.value > 0;

requires false;
void foo(TC_LI_25_Node x) {
    loop_invariant Perm(x.value, write) ** isWritePos(x);
    while (true) { }
}
