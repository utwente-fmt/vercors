int getInt();


// TODO (RR): Is there an easy way to keep this postcondition, if not just remove it. Is is implied trivialy by the run contract anyway
// ensures (\forall int i = 0 .. N; nodes[i].total == getTotal(nodes, 0, nodes[i].n));
requires |vals| == N;
choreography summation(int N, seq<int> vals) {
  endpoints nodes[tid := 0 .. N] = Node(vals[tid], tid);

  context (\endpoint nodes[i := 0 .. N]; 
    Perm(nodes[i].outMessage, 1) ** Perm(nodes[i].inMessage, 1) **
    Perm(nodes[i].total, 1) ** Perm(nodes[i].n, 1) **
    Perm(nodes[i].frontN, 1) ** Perm(nodes[i].backN, 1) **
    Perm(nodes[i].dummySend, 1) ** Perm(nodes[i].dummyReceive, 1));
  requires (\endpoint nodes[i := 0 .. N]; nodes[i].n == 0 && nodes[i].frontN == nodes[i].n && nodes[i].backN == nodes[i].n);
  requires (\endpoint nodes[i := 0 .. N]; nodes[i].total == nodes[i].v);
  requires (\endpoint nodes[i := 0 .. N]; nodes[i].inMessage == -1);
  requires (\endpoint nodes[i := 0 .. N]; nodes[i].outMessage == nodes[i].v);
  requires (\endpoint nodes[tid := 0 .. N]; (\forall int i = 0 .. N; nodes[i].tid == i));
  ensures (\endpoint nodes[i := 0 .. N]; nodes[i].n == N - 1);
  ensures (\endpoint nodes[i := 0 .. N]; nodes[i].total == getTotal(nodes, 0, nodes[i].n));
  run {
    // Parallel loop invariant
    loop_invariant (\endpoint nodes[i := 0 .. N - 1]; Perm(nodes[i].outMessage, 1));
    loop_invariant (\endpoint nodes[i := 0 .. N - 1]; (\let Node node = nodes[i];
      Perm(node.inMessage, 1) ** Perm(node.total, 1) **
      Perm(node.n, 1) ** Perm(node.frontN, 1) ** Perm(node.backN, 1\2) **
      Perm(node.dummySend, 1) ** Perm(node.dummyReceive, 1) **
      Perm(nodes[i + 1].backN, 1\2) **
      0 <= node.n ** node.n <= N - 1 **
      node.total == getTotal(nodes, node.tid, node.n) **
      node.total == node.outMessage **
      node.n == node.frontN ** node.n == node.backN **
      node.frontN == nodes[i+1].backN
      ));
    loop_invariant (\endpoint nodes[N - 1]; (\let int i = N - 1; (\let Node node = nodes[i];
      Perm(node.outMessage, 1) ** Perm(node.inMessage, 1) ** Perm(node.total, 1) **
      Perm(node.n, 1) ** Perm(node.frontN, 1) ** Perm(node.backN, 1\2) **
      Perm(node.dummySend, 1) ** Perm(node.dummyReceive, 1) **
      Perm(nodes[0].backN, 1\2) **
      0 <= node.n ** node.n <= N - 1 ** node.tid == i **
      node.total == getTotal(nodes, node.tid, node.n) **
      node.total == node.outMessage **
      node.n == node.frontN ** node.n == node.backN **
      node.frontN == nodes[0].backN
      )));

    // Choreographic loop invariant, required for choreographic verification. Without it, the only fact
    // the verifier gets at the beginning of the loop is that nodes[i].n < N - 1, for all indices i. However,
    // this inequality does not imply that they are actually equal. Hence, after incrementing each nodes[i].n by one,
    // the verifier concludes there might be an index i for which nodes[i] < N - 1 no longer holds. By including
    // the choreographic invariant, branch unanimity is maintained. The invariant must be used with the `\chor`
    // primitive because it is not representable at the endpoint projection level: PVL permissions are not flexible
    // enough to allow both 1) write access for a particular nodes[i], and 2) read access for all nodes[j] with j != i.
    loop_invariant (\chor (\forall int j = 0..N, int k = 0..N; nodes[j].n == nodes[k].n));
    while ((\endpoint nodes[i := 0..N]; nodes[i].n < N - 1)) {

      channel_invariant
        Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2) **
        \sender.frontN == \receiver.backN ** 0 <= \sender.frontN ** \sender.frontN <= N **
        \msg == getTotal(nodes, \sender.tid, \sender.frontN);
      communicate nodes[i := 0 .. N - 1]: nodes[i].outMessage -> nodes[i + 1].inMessage;
      communicate nodes[0].inMessage <- nodes[N - 1].outMessage;

      endpoint nodes[tid := 0 .. N]: nodes[tid].processMessage();
      // endpoint nodes[tid := 0 .. N]: nodes[tid].getTotalProofStep();
      endpoint nodes[tid := 0 .. N]: nodes[tid].updateBackN();

      channel_invariant Perm(\sender.backN, 1\2) ** Perm(\receiver.frontN, 1\2) ** \receiver.frontN + 1 == \sender.backN;
      communicate nodes[i := 1 .. N - 1]: nodes[i].dummySend -> nodes[i - 1].dummyReceive;
      communicate nodes[N - 1].dummyReceive <- nodes[0].dummySend;

      endpoint nodes[tid := 0 .. N]: nodes[tid].updateFrontN();
    }

    // Generalize each result from
    //   node.total == getTotal(nodes, node.tid, node.n)
    // to
    //   node.total == getTotal(nodes, 0, node.n)`
    // This makes it syntactically obvious that each endpoint computes the exact same result
    // (assuming all n fields are the same, which is also specified in the postcondition)
    endpoint nodes[tid := 0 .. N]: nodes[tid].generalizeResult(nodes);
  }
}
