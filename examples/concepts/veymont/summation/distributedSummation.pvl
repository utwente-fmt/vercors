class Dummy { }

adt  X {
  pure int add(int x, int y);
  axiom (∀int x, int y; {: add(x, y) :} == x + y);

  pure int sub(int x, int y);
  axiom (∀int x, int y; {: sub(x, y) :} == x - y);
}

// TODO (RR): Is there an easy way to keep this postcondition, if not just remove it. Is is implied trivialy by the run contract anyway
// ensures (\forall int i = 0 .. N; nodes[i].total == getTotal(nodes, 0, nodes[i].n));
requires |vals| == N;
requires N >= 2;
choreography summation(int N, seq<int> vals) {
  endpoint `witness` = Dummy();
  endpoints nodes[tid := 0 .. N] = Node(vals[tid], tid);

  requires (\endpoint `witness`; N >= 2);
  requires (\endpoint nodes[i := 0 .. N];
    Perm(nodes[i].outMessage, 1) ** Perm(nodes[i].inMessage, 1) **
    Perm(nodes[i].total, 1) ** Perm(nodes[i].n, 1) **
    Perm(nodes[i].dummySend, 1) ** Perm(nodes[i].dummyReceive, 1));
  requires (\endpoint nodes[i := 0 .. N - 1]; Perm(nodes[i].frontN, 1) ** Perm(nodes[i].backN, 1\2));
  requires (\endpoint nodes[i := 0 .. N - 1], ∀int j = i + 1; Perm(nodes[j].backN, 1\2));
  requires (\endpoint nodes[N - 1];
    Perm(nodes[N-1].frontN, 1) ** Perm(nodes[N-1].backN, 1\2) ** Perm(nodes[0].backN, 1\2)
  );
  requires (\endpoint nodes[i := 0 .. N - 1];
    {: nodes[i].n :} == 0 &&
    {: nodes[i].frontN :} == nodes[i].n &&
    {: nodes[i].backN :} == nodes[i].n &&
    nodes[i + 1].backN == {: nodes[i].n :});
  requires (\endpoint nodes[N - 1]; nodes[N - 1].n == 0 && nodes[N - 1].frontN == nodes[N - 1].n && nodes[N - 1].backN == nodes[N - 1].n && nodes[0].backN == nodes[N - 1].n);
  requires (\endpoint nodes[i := 0 .. N]; {: nodes[i].total :} == nodes[i].v);
  requires (\endpoint nodes[i := 0 .. N]; {: nodes[i].inMessage :} == -1);
  requires (\endpoint nodes[i := 0 .. N]; {: nodes[i].outMessage :} == nodes[i].v);
  requires (\endpoint nodes[tid := 0 .. N]; (\forall int i = 0 .. N; {: nodes[i].tid :} == i));
  // ensures (\endpoint nodes[i := 0 .. N]; nodes[i].n == N - 1);
  // ensures (\endpoint nodes[i := 0 .. N]; nodes[i].total == getTotal(nodes, 0, nodes[i].n));
  run {
//    endpoint nodes[i := 0 .. N - 1]: nodes[i].couple(nodes[i + 1]);
//    endpoint nodes[N - 1]: nodes[N - 1].couple(nodes[0]);

    // Parallel loop invariant
    loop_invariant (\endpoint nodes[i := 0 .. N];
      Perm(nodes[i].outMessage, 1) ** Perm(nodes[i].inMessage, 1) ** Perm(nodes[i].total, 1) **
      Perm(nodes[i].n, 1) ** Perm(nodes[i].frontN, 1) ** Perm(nodes[i].backN, 1\2) **
      Perm(nodes[i].dummySend, 1) ** Perm(nodes[i].dummyReceive, 1)
    );
    loop_invariant (\endpoint nodes[i := 0 .. N - 1], ∀int j = i + 1; Perm(nodes[j].backN, 1\2));
    loop_invariant (\endpoint nodes[N - 1]; Perm(nodes[0].backN, 1\2));
    loop_invariant (\endpoint nodes[i := 0 .. N - 1];
      0 <= {: nodes[i].n :} ** {: nodes[i].n :} <= N - 1 **
      {: nodes[i].total :} == getTotal(nodes, nodes[i].tid, nodes[i].n) **
      nodes[i].total == {: nodes[i].outMessage :} **
      nodes[i].n == {: nodes[i].frontN :} ** nodes[i].n == {: nodes[i].backN :}
    );
    // WARNING: Must be after all permission inhales, because trigger on frontN includes heap argument (.frontN is encoded as function readN, which is heap dependent)
    // If placed before an inhale of a new frontN permission, the heap argument used in the trigger will never appear again later when the quantifier is needed to prove an assertion.
    // Can be avoided by making sure all relevant permissions are required in one go in the loop invariant; then the order of pure facts doesn't matter.
    // Note: separate because inline quantifier gets propagated to the other quantifiers if we merge it with the loop_inv a few lines up.
    loop_invariant (\endpoint nodes[i := 0 .. N - 1], ∀int j = i + 1; {: nodes[i].frontN :} == {: nodes[j].backN :});
    loop_invariant (\endpoint nodes[N - 1];
      0 <= nodes[N - 1].n ** nodes[N - 1].n <= N - 1 ** nodes[N - 1].tid == N - 1 **
      nodes[N - 1].total == getTotal(nodes, nodes[N - 1].tid, nodes[N - 1].n) **
      nodes[N - 1].total == nodes[N - 1].outMessage **
      nodes[N - 1].n == nodes[N - 1].frontN ** nodes[N - 1].n == nodes[N - 1].backN **
      nodes[N - 1].frontN == nodes[0].backN
    );
    // Choreographic loop invariant, required for choreographic verification. Without it, the only fact
    // the verifier gets at the beginning of the loop is that nodes[i].n < N - 1, for all indices i. However,
    // this inequality does not imply that they are actually equal. Hence, after incrementing each nodes[i].n by one,
    // the verifier concludes there might be an index i for which nodes[i] < N - 1 no longer holds. By including
    // the choreographic invariant, branch unanimity is maintained. The invariant must be used with the `\chor`
    // primitive because it is not representable at the endpoint projection level: PVL permissions are not flexible
    // enough to allow both 1) write access for a particular nodes[i], and 2) read access for all nodes[j] with j != i.
    loop_invariant (\chor (\forall int j = 0..N, int k = 0..N; (\endpoint nodes[j]; {: nodes[j].n :}) == (\endpoint nodes[k]; {: nodes[k].n :})));
    while ((\endpoint nodes[i := 0..N]; nodes[i].n < N - 1)) {

      channel_invariant
        Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2) **
        {: \sender.frontN :} == {: \receiver.backN :} ** 0 <= {: \sender.frontN :} ** {: \sender.frontN :} <= N **
        {: \msg :} == {: getTotal(nodes, \sender.tid, \sender.frontN) :};
      communicate nodes[i := 0 .. N - 1]: nodes[i].outMessage -> nodes[i + 1].inMessage;
      channel_invariant
        Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2) **
        \sender.frontN == \receiver.backN ** 0 <= \sender.frontN ** \sender.frontN <= N **
        \msg == getTotal(nodes, \sender.tid, \sender.frontN);
      communicate nodes[0].inMessage <- nodes[N - 1].outMessage;

      endpoint nodes[tid := 0 .. N]: nodes[tid].processMessage();
      // endpoint nodes[tid := 0 .. N]: nodes[tid].getTotalProofStep();
      // endpoint nodes[tid := 0 .. N]: nodes[tid].mergeBackNPerms(nodes);
      // TODO (RR): updateBackN contract needs to be adjusted to handle case for 0 (wraparound case)
      endpoint nodes[tid := 0 .. N]: nodes[tid].updateBackN(nodes, tid - 1);

      // TODO (RR): \receiver.frontN fails here. Probably something with sub/add again?
      channel_invariant Perm(\sender.backN, 1\2) ** Perm(\receiver.frontN, 1\2) ** {: \receiver.frontN :} + 1 == {: \sender.backN :};
      communicate nodes[i := 1 .. N]: nodes[i].dummySend -> nodes[i - 1].dummyReceive;
      channel_invariant Perm(\sender.backN, 1\2) ** Perm(\receiver.frontN, 1\2) ** \receiver.frontN + 1 == \sender.backN;
      communicate nodes[N - 1].dummyReceive <- nodes[0].dummySend;

      endpoint nodes[tid := 0 .. N]: nodes[tid].updateFrontN();
    }

    // Generalize each result from
    //   node.total == getTotal(nodes, node.tid, node.n)
    // to
    //   node.total == getTotal(nodes, 0, node.n)`
    // This makes it syntactically obvious that each endpoint computes the exact same result
    // (assuming all n fields are the same, which is also specified in the postcondition)
    endpoint nodes[tid := 0 .. N]: nodes[tid].generalizeResult(nodes);
  }
}
