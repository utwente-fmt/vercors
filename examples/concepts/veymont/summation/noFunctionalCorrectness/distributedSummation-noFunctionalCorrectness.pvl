// Adding the two uncommented loop invariants seem to increase verification time by 10s, though not very reliably.

requires |vals| == N;
requires N >= 2;
choreography summation(int N, seq<int> vals) {
  endpoints nodes[tid := 0 .. N] = Node(vals[tid], tid);

  requires (\chor N >= 2);
  requires (\endpoint nodes[i := 0 .. N];
    Perm(nodes[i].outMessage, 1) ** Perm(nodes[i].inMessage, 1) **
    Perm(nodes[i].total, 1) ** Perm(nodes[i].n, 1) **
    Perm(nodes[i].dummySend, 1) ** Perm(nodes[i].dummyReceive, 1));
  requires (\endpoint nodes[i := 0 .. N - 1]; Perm(nodes[i].frontN, 1) ** Perm(nodes[i].backN, 1\2));
  requires (\endpoint nodes[i := 0 .. N - 1], ∀int j = i + 1; Perm(nodes[j].backN, 1\2));
  requires (\endpoint nodes[N - 1];
    Perm(nodes[N-1].frontN, 1) ** Perm(nodes[N-1].backN, 1\2) ** Perm(nodes[0].backN, 1\2)
  );
  requires (\endpoint nodes[i :=  0 .. N]; {: nodes[i].n :} == 0 ** {: nodes[i].outMessage :} == nodes[i].total);
  run {
    // Parallel loop invariant
    loop_invariant (\endpoint nodes[i := 0 .. N];
      Perm(nodes[i].outMessage, 1) ** Perm(nodes[i].inMessage, 1) ** Perm(nodes[i].total, 1) **
      Perm(nodes[i].n, 1) ** Perm(nodes[i].frontN, 1) ** Perm(nodes[i].backN, 1\2) **
      Perm(nodes[i].dummySend, 1) ** Perm(nodes[i].dummyReceive, 1)
    );
    loop_invariant (\endpoint nodes[i := 0 .. N - 1], ∀int j = i + 1; Perm(nodes[j].backN, 1\2));
    loop_invariant (\endpoint nodes[N - 1]; Perm(nodes[0].backN, 1\2));
    // loop_invariant (\endpoint nodes[i := 0 .. N]; {: nodes[i].n :} \in {0 .. N});
    // loop_invariant (\endpoint nodes[i := 0 .. N]; nodes[i].total == {: nodes[i].outMessage :});
    // Choreographic loop invariant, required for choreographic verification. Without it, the only fact
    // the verifier gets at the beginning of the loop is that nodes[i].n < N - 1, for all indices i. However,
    // this inequality does not imply that they are actually equal. Hence, after incrementing each nodes[i].n by one,
    // the verifier concludes there might be an index i for which nodes[i] < N - 1 no longer holds. By including
    // the choreographic invariant, branch unanimity is maintained. The invariant must be used with the `\chor`
    // primitive because it is not representable at the endpoint projection level: PVL permissions are not flexible
    // enough to allow both 1) write access for a particular nodes[i], and 2) read access for all nodes[j] with j != i.
    loop_invariant (\chor (\forall int j = 0..N, int k = 0..N; (\endpoint nodes[j]; {: nodes[j].n :}) == (\endpoint nodes[k]; {: nodes[k].n :})));
    while ((\endpoint nodes[i := 0..N]; nodes[i].n < N - 1)) {
      channel_invariant Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2);
      communicate nodes[i := 0 .. N - 1]: nodes[i].outMessage -> nodes[i + 1].inMessage;

      channel_invariant Perm(\sender.frontN, 1\2) ** Perm(\receiver.backN, 1\2);
      communicate nodes[0].inMessage <- nodes[N - 1].outMessage;

      endpoint nodes[tid := 0 .. N]: nodes[tid].processMessage(nodes);
      endpoint nodes[tid := 0 .. N]: nodes[tid].updateBackN();

      channel_invariant Perm(\sender.backN, 1\2) ** Perm(\receiver.frontN, 1\2);
      communicate nodes[i := 1 .. N]: nodes[i].dummySend -> nodes[i - 1].dummyReceive;
      channel_invariant Perm(\sender.backN, 1\2) ** Perm(\receiver.frontN, 1\2);
      communicate nodes[N - 1].dummyReceive <- nodes[0].dummySend;

      endpoint nodes[tid := 0 .. N]: nodes[tid].updateFrontN();
    }
  }
}
