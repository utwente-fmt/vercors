requires n > 0;
requires -n <= i && i < n + n;
ensures 0 <= \result && \result < n;
pure int mod(int i, int n) =
  i < 0 ? i + n : (i >= n ? i - n : i);

pure boolean nn(seq<Node> xs) =
  (\forall int i = 0 .. |xs|; {: xs[i] :} != null);

boolean pickBoolean();

int arbitraryInt();

pure boolean injective(seq<Node> xs) = (\forall int i, int j; i \in {0 .. |xs|} && j \in {0 .. |xs|} && i != j; {: xs[i] :} != {: xs[j] :});

// This is the context object that allows each node to name each other node.
// It is an axiomatized global struct containing all nodes, so it can be constructed
// by scanning the program for all node types and adding a "get" for each group of nodes.
//
// Can be enhanced with a "This" pointer to make later adaptation to instantiating protocols easier
adt Ns {
  pure seq<Node> get();

  // None of the nodes are null
  axiom (\forall int i = 0 .. |get()|; get()[i] != null);
}

