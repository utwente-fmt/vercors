// Goal: check if we can solve the n+1 not verifiable case from the onlyN minimizer

requires |vals| == N;
requires N >= 2;
choreography summation(int N, seq<int> vals) {
  endpoints nodes[tid := 0 .. N] = Node(vals[tid], tid);

  requires (\chor N >= 2);
  requires (\endpoint nodes[i := 0 .. N]; Perm(nodes[i].n, 1));
  run {
    communicate nodes[0].n <- nodes[N - 1].n;

    label C;

    endpoint nodes[tid := 0 .. N]: nodes[tid].processMessage_onlyN(nodes);
    // exhale (\endpoint nodes[i := 0 .. N]; Perm(nodes[i].n, 1));
    // inhale (\endpoint nodes[i := 0 .. N]; Perm(nodes[i].n, 1) ** nodes[i].n == \old[C](nodes[i].n) + 1);

    label D;
    assert (\endpoint nodes[i := 1 .. N]; {: \old[D](nodes[i].n) :} == \old[C](nodes[i].n) + 1);

    endpoint nodes[tid := 0 .. N]: nodes[tid].updateBackN_onlyN();

    assert (\endpoint nodes[i := 1 .. N]; {: nodes[i].n :} == \old[D](nodes[i].n));
    assert (\endpoint nodes[i := 1 .. N]; {: nodes[i].n :} == \old[C](nodes[i].n) + 1);
  }
}
