context wfNodes(nodes);
requires 0 <= i && i < |nodes|;
requires 1 <= rounds && rounds <= |nodes|;
ensures getTotal(nodes, i, rounds) == getTotal(nodes, next(i, |nodes|), rounds - 1) + nodes[i].v;
void lemmaGetTotalHead(seq<Node> nodes, int i, int rounds) {
  // True by the definition of getTotal
}

context wfNodes(nodes);
requires 0 <= i && i < |nodes|;
requires 1 <= rounds && rounds <= |nodes|;
ensures getTotal(nodes, i, rounds) == getTotal(nodes, i, rounds - 1) + nodes[mod(i - rounds, |nodes|)].v;
void lemmaGetTotalLast(seq<Node> nodes, int i, int rounds) {
  if (rounds == 1) {
      // Base case
      // Since rounds == 1, we can be sure getTotal will be unfolded for one more recursive step
      assert getTotal(nodes, i, rounds) == nodes[i].v + getTotal(nodes, next(i, |nodes|), rounds - 1);
      // With that hint, vercors can handle the base case.
  } else {
      // Inductive case 
      // First we split off the last element off the tail of sequence starting
      // at the current position
      lemmaGetTotalLast(nodes, next(i, |nodes|), rounds - 1);

      // Now we have taken of the last of the tail of the current section:
      // (Nonessential assert)
      assert getTotal(nodes, next(i, |nodes|), rounds - 1) 
          == getTotal(nodes, next(i, |nodes|), rounds - 1 - 1) 
              + nodes[mod(next(i, |nodes|) - (rounds - 1), |nodes|)].v;

      // VerCors can figure out the proof-by-picture from this point on
  }
}

given frac P;
context 0 < P && P < write;
context |nodes| > 2;
context 0 <= a && a < |nodes|;
context 0 <= b && b < |nodes|;
context wfNodes(nodes);
context (\forall* int i = 0 .. |nodes|; Perm({: nodes[i].total :}, P));
requires nodes[a].total == getTotal(nodes, a, |nodes| - 1);
requires nodes[b].total == getTotal(nodes, b, |nodes| - 1);
requires mod(a + 1, |nodes|) == b;
ensures nodes[a].total == nodes[b].total;
void lemmaTotalAB(seq<Node> nodes, int a, int b) {
  //////////////////////////
  // Deconstrueren voor a //
  //////////////////////////

  // (Nonessential assert)
  assert nodes[a].total == getTotal(nodes, a, |nodes| - 1);
  
  // (Nonessential assert)
  assert nodes[a].total == getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1) + nodes[a].v;
  lemmaGetTotalLast(nodes, next(a, |nodes|), |nodes| - 1 - 1);

  // (Nonessential assert)
  assert nodes[a].total == getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1 - 1) 
    + nodes[b].v 
    + nodes[a].v;

  //////////////////////////
  // Deconstrueren voor b //
  //////////////////////////

  // (Nonessential assert)
  assert nodes[b].total == getTotal(nodes, b, |nodes| - 1);

  // Peel off the next node, which is node 1
  lemmaGetTotalHead(nodes, next(b, |nodes|), |nodes| - 1 - 1);

  assert nodes[b].total == 
    getTotal(nodes, next(next(b, |nodes|), |nodes|), |nodes| - 1 - 1 - 1) 
      + nodes[a].v 
      + nodes[b].v;
}

context |nodes| > 2;
context wfNodes(nodes);
context 0 <= a && a < |nodes| - 1;
ensures getTotal(nodes, a, |nodes| - 1) == getTotal(nodes, a + 1, |nodes| - 1);
void lemmaTotalShiftRight1(seq<Node> nodes, int a) {
  int b = a + 1;

  //////////////////////////
  // Deconstrueren voor a //
  //////////////////////////
  
  // (Nonessential assert) Unfold getTotal(a) once
  assert getTotal(nodes, a, |nodes| - 1) == getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1) + nodes[a].v;

  // (Essential) Peel of last element of getTotal next(a), which is b
  lemmaGetTotalLast(nodes, next(a, |nodes|), |nodes| - 1 - 1);

  // (Nonessential assert) Result of lemmaGetTotalLast
  assert getTotal(nodes, a, |nodes| - 1) == getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1 - 1) 
    + nodes[b].v 
    + nodes[a].v;

  //////////////////////////
  // Construct a from b   //
  //////////////////////////

  // (Essential) Unfold getTotal for b
  assert getTotal(nodes, b, |nodes| - 1) == getTotal(nodes, next(b, |nodes|), |nodes| - 1 - 1) + nodes[b].v;
  // (Nonessential assert) a is naturally next(b)
  assert a == next(b, |nodes|);
  // (Nonessential assert) Fold getTotal of a back up
  assert getTotal(nodes, b, |nodes| - 1) == getTotal(nodes, a, |nodes| - 1);
  // (Nonessential assert) Hence:
  assert getTotal(nodes, a, |nodes| - 1) == getTotal(nodes, b, |nodes| - 1);
}

context |nodes| > 2;
context wfNodes(nodes);
context 0 <= a && a < |nodes|;
context 0 <= b && b < |nodes|;
requires a < b; // a == b: trivial, b < a: just call the lemma in reverse
ensures getTotal(nodes, a, |nodes| - 1) == getTotal(nodes, b, |nodes| - 1);
void lemmaTotalShiftRight(seq<Node> nodes, int a, int b) {
  loop_invariant a <= i && i <= b;
  loop_invariant getTotal(nodes, a, |nodes| - 1) == getTotal(nodes, i, |nodes| - 1);
  for (int i = a; i < b; i++) {
    lemmaTotalShiftRight1(nodes, i);
  }
}

context wfNodes(nodes);
context 0 <= a && a < |nodes|;
context 0 <= b && b < |nodes|;
ensures getTotal(nodes, a, |nodes| - 1) == getTotal(nodes, b, |nodes| - 1);
void lemmaTotalShift(seq<Node> nodes, int a, int b) {
  if (a == b) {
    // Trivial
  } else if (|nodes| < 2) {
    // Trivial
  } else if (|nodes| == 2) {
    // Unfold both sides once
    assert getTotal(nodes, a, |nodes| - 1) == 
      nodes[a].v +
      getTotal(nodes, next(a, |nodes|), |nodes| - 2);
    assert getTotal(nodes, b, |nodes| - 1) == 
      nodes[b].v +
      getTotal(nodes, next(b, |nodes|), |nodes| - 2);
  } else if (a < b) {
    lemmaTotalShiftRight(nodes, a, b);
  } else {
    lemmaTotalShiftRight(nodes, b, a);
  }
}

given frac P;
context 0 < P && P < write;
context wfNodes(nodes);
context (\forall* int i = 0 .. |nodes|; Perm({: nodes[i].total :}, P));
context (\forall int i = 0 .. |nodes|; {: nodes[i].total :} == getTotal(nodes, i, |nodes| - 1));
requires |nodes| == 2;
ensures (\forall int i = 0 .. |nodes|; nodes[0].total == nodes[i].total);
void lemmaTotal2(seq<Node> nodes) {
  assert nodes[0].total == nodes[0].v + getTotal(nodes, 1, |nodes| - 1 - 1);
  assert nodes[0].total == nodes[0].v + nodes[1].v;
  assert nodes[1].total == nodes[1].v + getTotal(nodes, 0, |nodes| - 1 - 1);
  assert nodes[1].total == nodes[1].v + nodes[0].v;
}

given frac P;
context 0 < P && P < write;
context_everywhere wfNodes(nodes);
context_everywhere (\forall* int i = 0 .. |nodes|; Perm({: nodes[i].total :}, P));
context_everywhere (\forall int i = 0 .. |nodes|; {: nodes[i].total :} == getTotal(nodes, i, |nodes| - 1));
ensures (\forall int i = 0 .. |nodes|; nodes[0].total == nodes[i].total);
void lemmaTotal(seq<Node> nodes) {
  if (|nodes| < 2) {
    // Q.e.d.
  } else if (|nodes| == 2) {
    lemmaTotal2(nodes) given { P = P\2 };
  } else {
    loop_invariant 1 <= i && i <= |nodes|;
    loop_invariant (\forall int j = 0 .. i; nodes[0].total == {: nodes[j].total :});
    for (int i = 1; i < |nodes|; i++) {
      lemmaTotalAB(nodes, i - 1, i) given { P = P\2 };
    }
  }
}

