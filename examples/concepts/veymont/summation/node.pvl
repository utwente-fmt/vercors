resource syncd(Node node, Node next) =
  Perm(node.frontN, 1\10) ** Perm(next.backN, 1\10) **
  node.frontN == next.backN;

class Node {
  // When this was a plain "int v", verification kept getting stuck on calculating the right permission amounts to divide over the par block.
  final int v;

  // ensures 0 <= \result && \result < |nodes()|;
  final int tid;

  // !! different: properly encoded as ADT now
  // ensures |\result| > 0;
  // final seq<Node> nodes;

  int inMessage, outMessage, dummySend, dummyReceive, total;
  int n, frontN, backN;

  // requires |Ns.get()| > 0;
  // requires 0 <= tid && tid < |Ns.get()|;
  // ensures 0 <= \result && \result < |Ns.get()|;
  // /* !! different: global knowledge is used here. But nextTid is intended to be a concrete function.
  //    So need to be careful that ghost knowledge is not mixed with concrete execution here.
  //  */
  // pure int nextTid() = next(tid, |Ns.get()|);

  // requires |Ns.get()| > 0;
  // requires 0 <= tid && tid < |Ns.get()|;
  // ensures \result != null;
  // pure Node nextNode() = Ns.get()[nextTid()];

  // pure boolean wf() =
  //   |Ns.get()| >= 1 &&
  //   0 <= tid && tid < |Ns.get()|;

  ensures Perm(outMessage,1) ** Perm(inMessage,1) ** Perm(n,1) ** Perm(frontN, 1) ** Perm(backN, 1) ** Perm(total,1) **
    Perm(dummySend, 1) ** Perm(dummyReceive, 1);
  ensures v == myValue ** outMessage == v ** inMessage == -1 ** n == 0 ** total == v ** tid == myTid **
    frontN == 0 ** backN == 0;
  constructor(int myValue, int myTid) {
    v = myValue;
    outMessage = v;
    inMessage = -1;
    n = 0;
    total = v;
    tid = myTid;
    frontN = 0;
    backN = 0;
  }

  context Perm(total, 1\2) ** Perm(n, 1\2);
  requires n == 0;
  requires |nodes| >= 0;
  requires 0 <= tid && tid < |nodes|;
  requires nn(nodes);
  requires nodes[tid] == this;
  requires total == v;
  ensures n == 0;
  ensures total == getTotal(nodes, tid, n);
  void getTotal_init(seq<Node> nodes) {
    open_getTotal();
    assert n == 0;
    assert total == getTotal(nodes, tid, n);
  }

  // // TODO: How about using sub(add(tid, 1), 1)?
  // requires Perm(nodes[X.add(tid, 1) - 1].backN, 1\2);
  // requires Perm(nodes[tid].backN, 1\2);
  // ensures Perm(nodes[tid].backN, 1) ** nodes[tid].backN ==//  \old(nodes[tid].backN);
  // void mergeBackNPerms(seq<Node> nodes) {
  //
  // }

  context Perm(outMessage, 1) ** Perm(inMessage, 1\2) ** Perm(n, 1) ** Perm(total, 1);
  requires (\forall int i = 0 .. |nodes|; nodes[i] != null);
  requires |nodes| > 0;
  requires 0 <= tid && tid < |nodes|;
  requires 0 <= n && n < |nodes|;
  requires inMessage == getTotal(nodes, next(tid, |nodes|), n);
  requires nodes[tid] == this;
  ensures n == \old(n) + 1;
  ensures inMessage == \old(inMessage);
  ensures total == inMessage + v;
  ensures outMessage == total;
  ensures outMessage == getTotal(nodes, tid, n);
  boolean processMessage(seq<Node> nodes) {
    open_getTotal();

    total = inMessage + v;
    outMessage = total;
    n++;
  }

  requires Perm(frontN, 1\10) ** Perm(next.backN, 1\10) ** frontN == next.backN;
  ensures syncd(this, next);
  void couple(Node next) {
    fold syncd(this, next);
  }

  requires syncd(this, next);
  ensures Perm(frontN, 1\10) ** Perm(next.backN, 1\10) ** frontN == next.backN;
  void uncouple(Node next) {
    unfold syncd(this, next);
  }

  requires 0 <= tid && tid < |nodes|;
  requires nn(nodes);
  ensures getTotal(nodes, tid, |nodes| - 1) == getTotal(nodes, 0, |nodes| - 1);
  void generalizeResult(seq<Node> nodes) {
    lemmaTotalShift(nodes, tid, 0);
  }

  requires Perm(backN, 1);
  context Perm(n, 1\2);
  ensures Perm(backN, 1);
  ensures backN == n;
  void updateBackN() {
    backN = n;
  }

  context Perm(frontN, 1) ** Perm(n, 1\2);
  ensures frontN == n;
  void updateFrontN() {
    frontN = n;
  }
}

ensures (\forall seq<Node> nodes, int i, int rounds;
  nn(nodes) &&
  0 <= i && i < |nodes| &&
  0 <= rounds && rounds <= |nodes|;
  {: getTotal(nodes, i, rounds) :} == getTotal_impl(nodes, i, rounds));
void open_getTotal();

requires nn(nodes);
requires 0 <= i && i < |nodes|;
requires 0 <= rounds && rounds <= |nodes|;
pure int getTotal(seq<Node> nodes, int i, int rounds);

requires nn(nodes);
requires 0 <= i && i < |nodes|;
requires 0 <= rounds && rounds <= |nodes|;
pure int getTotal_impl(seq<Node> nodes, int i, int rounds) =
  rounds == 0
    ? nodes[i].v
    : (\let int nextI = next(i, |nodes|);
      (\let int nextTotal = getTotal_impl(nodes, nextI, rounds - 1);
        nextTotal + nodes[i].v))
  ;

requires size > 0;
requires 0 <= i && i < size;
ensures 0 <= \result && \result < size;
pure int next(int i, int size) = mod(i - 1, size);

requires size > 0;
requires 0 <= i && i < size;
ensures 0 <= \result && \result < size;
pure int prev(int i, int size) = mod(i + 1, size);

// Not sure why this was ever here?
// requires (\forall* int i = 0 .. |nodes|; Perm(nodes[i].n, read));
// pure boolean nLessThanLength(seq<Node> nodes) =
//   (\forall int j=0..|nodes|; nodes[j].n < |nodes| - 1);

inline resource wfNodes(seq<Node> nodes) = nn(nodes);

