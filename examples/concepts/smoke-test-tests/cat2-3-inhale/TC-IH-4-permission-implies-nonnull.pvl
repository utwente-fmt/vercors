//:: cases TC_IH_4_PermissionImpliesNonNull
//:: tools silicon
//:: verdict Fail

// Write permission on a field implies the object is non-null.
class Box { int val; }

requires Perm(b.val, write);
void f(Box b) {
    if (b == null) {
        return; // dead: write permission on b.val implies b != null
    }
}
