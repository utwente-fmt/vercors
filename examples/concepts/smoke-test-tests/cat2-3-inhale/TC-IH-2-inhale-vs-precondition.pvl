//:: cases TC_IH_2_InhaleVsPrecondition
//:: tools silicon
//:: verdict Fail

// Same as TC-AS-2 but via inhale, and over a reference type.
class Box { int val; }

requires p != null;
void f(Box p) {
    inhale p == null; // contradicts precondition p != null
    if (p != null) {
        return; // dead: state is contradictory (p != null AND p == null)
    }
}
