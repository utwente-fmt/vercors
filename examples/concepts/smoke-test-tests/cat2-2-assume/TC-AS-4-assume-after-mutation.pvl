//:: cases TC_AS_4_AssumeAfterMutation
//:: tools silicon
//:: verdict Fail

// assume applies to the mutated value, not the original precondition.
requires x == 21;
void f(int x) {
    x = x - 1;       // x is now 20
    assume x == 21;   // false: x is 20, not 21 — state becomes contradictory
    if (x != 1) {
        x = x + 1; // dead: state is contradictory after assume
    }
}
