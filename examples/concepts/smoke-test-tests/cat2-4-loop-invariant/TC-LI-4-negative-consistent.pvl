//:: cases TC_LI_4_NegativeConsistent
//:: tools silicon
//:: verdict Pass

// Negative: post-loop branch is live.
requires x == 0;
void f(int x) {
    loop_invariant x >= 0;
    loop_invariant x <= 20;
    while (x < 10) { x = x + 1; }
    if (x >= 10) {
        refute false; // live: invariant + exit condition guarantee x >= 10
    }
}
