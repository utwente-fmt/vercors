//:: cases TC_LI_20_InvariantFunctionCallSat
//:: tools silicon
//:: verdict Pass

// Invariant calls a function whose precondition it also satisfies.

requires x >= 0;
pure boolean nonNeg(int x) = x >= 0;

requires x >= 0;
void foo(int x) {
    loop_invariant x >= 0;
    loop_invariant nonNeg(x);
    while (x > 0) {
        x = x - 1;
    }
}
