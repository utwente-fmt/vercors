//:: cases TC_LI_8_PostLoopContextEverywhereDead
//:: tools silicon
//:: verdict Fail

// Same as TC-LI-7 but via context_everywhere.
requires x > 10;
context_everywhere x > 10;
void f(int x) {
    while (x > 0) {
        x = x + 1; // maintains x > 10; loop never exits
    }
    int dead = x; // unreachable: post-loop state is unsatisfiable
}
