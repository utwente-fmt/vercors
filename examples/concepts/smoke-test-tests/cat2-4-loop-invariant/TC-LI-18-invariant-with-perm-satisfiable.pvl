//:: cases TC_LI_18_InvariantWithPermSatisfiable
//:: tools silicon
//:: verdict Pass

// Resource-based invariant (permission + value constraint), satisfiable.
class Cell {
    int val;

    requires Perm(this.val, write) ** this.val >= 0;
    void count() {
        loop_invariant Perm(this.val, write) ** this.val >= 0;
        while (this.val < 10) { this.val = this.val + 1; }
    }
}
