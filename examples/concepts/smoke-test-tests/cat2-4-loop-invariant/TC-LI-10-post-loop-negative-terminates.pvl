//:: cases TC_LI_10_PostLoopNegativeTerminates
//:: tools silicon
//:: verdict Pass

// Negative: loop terminates, post-loop state is live.
requires x >= 0;
void f(int x) {
    loop_invariant x >= 0;
    while (x < 10) {
        x = x + 1; // maintains x >= 0; loop terminates when x = 10
    }
    // post-loop state: x >= 0 AND x >= 10 — satisfiable (e.g. x = 10)
    int live = x; // LIVE — correctly no error reported
}
