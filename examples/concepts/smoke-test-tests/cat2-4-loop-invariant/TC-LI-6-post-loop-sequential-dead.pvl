//:: cases TC_LI_6_PostLoopSequentialDead
//:: tools silicon
//:: verdict Fail

// TC-LI-6: Invariant x > 0 combined with the exit condition !(x > 0) makes the
// post-loop state unsatisfiable, so the post-loop deadBranch fires.
// Expected errors: 1 (deadBranch for code after loop).
requires x > 0;
void f(int x) {
    loop_invariant x > 0;
    while (x > 0) {
        x = x + 1; // maintains invariant; loop never exits
    }
    int dead = x; // unreachable: post-loop state is unsatisfiable
}
