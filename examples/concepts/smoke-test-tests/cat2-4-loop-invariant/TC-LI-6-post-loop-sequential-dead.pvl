//:: cases TC_LI_6_PostLoopSequentialDead
//:: tools silicon
//:: verdict Fail

// Invariant + negated exit condition makes post-loop state dead.
requires x > 0;
void f(int x) {
    loop_invariant x > 0;
    while (x > 0) {
        x = x + 1; // maintains invariant; loop never exits
    }
    int dead = x; // unreachable: post-loop state is unsatisfiable
}
