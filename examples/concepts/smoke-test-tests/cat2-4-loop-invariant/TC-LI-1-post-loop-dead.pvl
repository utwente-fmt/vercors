//:: cases TC_LI_1_PostLoopDead
//:: tools silicon
//:: verdict Fail

// Post-loop branch dead under invariant + negated exit condition.
requires x >= 0;
void f(int x) {
    loop_invariant x >= 0;
    while (x < 10) { x = x + 1; }
    // post-loop state: x >= 0 AND x >= 10, so x >= 10
    if (x < 0) {
        return; // dead: x >= 10 contradicts x < 0
    }
}
