//:: cases TC_LI_5_DeadBranchInLiveBody
//:: tools silicon
//:: verdict Fail

// The loop body as a whole is live, but the invariant x > 0 rules out the
// x < 0 branch inside it — only that inner branch is dead.
requires x > 0;
void f(int x) {
    loop_invariant x > 0;
    while (x < 10) {
        // loop body is live: x starts > 0 and loop condition is x < 10
        if (x < 0) {
            refute false; // dead: invariant x > 0 contradicts x < 0
        }
        if (x > 0) {
            refute false; // live: invariant guarantees x > 0
        }
        x = x + 1;
    }
}
