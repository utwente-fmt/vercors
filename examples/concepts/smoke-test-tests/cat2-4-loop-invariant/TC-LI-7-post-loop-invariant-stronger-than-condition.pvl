//:: cases TC_LI_7_PostLoopInvariantStrongerThanCondition
//:: tools silicon
//:: verdict Fail

// Invariant stronger than the loop condition — loop never exits.
requires x > 10;
void f(int x) {
    loop_invariant x > 10;
    while (x > 0) {
        x = x + 1; // maintains x > 10; exit condition x <= 0 unreachable
    }
    int dead = x; // unreachable: post-loop state is unsatisfiable
}
