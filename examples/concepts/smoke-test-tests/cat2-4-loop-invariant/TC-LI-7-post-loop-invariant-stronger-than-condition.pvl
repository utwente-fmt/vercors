//:: cases TC_LI_7_PostLoopInvariantStrongerThanCondition
//:: tools silicon
//:: verdict Fail

// TC-LI-7: Invariant x > 10 is strictly stronger than condition x > 0, so the
// loop can never exit. The post-loop state (x > 10 AND x <= 0) is
// unsatisfiable, so the post-loop deadBranch fires.
// Expected errors: 1 (deadBranch for code after loop).
requires x > 10;
void f(int x) {
    loop_invariant x > 10;
    while (x > 0) {
        x = x + 1; // maintains x > 10; exit condition x <= 0 unreachable
    }
    int dead = x; // unreachable: post-loop state is unsatisfiable
}
