//:: cases TC_LI_19_NestedLoopBothChecked
//:: tools silicon
//:: verdict Fail

// Nested loops — only the inner invariant is unsatisfiable.
void f(int n) {
    loop_invariant n >= 0;
    while (n > 0) {
        int j = 0;
        loop_invariant j > 0 && j < 0;
        while (j < 5) { j = j + 1; }
        n = n - 1;
    }
}
