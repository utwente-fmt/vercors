//:: cases TC_LI_23_InvariantPermFunctionCallSat
//:: tools silicon
//:: verdict Pass

// Perm(x.value, write) appears both directly and via isPositive(x)'s precondition.
// Regression guard against WD double-counting it as unsatisfiable.
class Node {
    int value;
}

requires Perm(n.value, write);
pure boolean isPositive(Node n) = n.value > 0;

requires Perm(x.value, write) ** x.value > 0;
void increment(Node x) {
    loop_invariant Perm(x.value, write) ** isPositive(x);
    while (x.value < 100) {
        x.value = x.value + 1;
    }
}
