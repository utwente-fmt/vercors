//:: cases TC_LI_21_InvariantFunctionCallUnsat
//:: tools silicon
//:: verdict Fail

// Same as TC-LI-20 but the called function is always false.

requires x >= 0;
pure boolean impossible(int x) = x < 0;

void foo(int n) {
    int x = 0;
    loop_invariant x >= 0 && impossible(x);
    while (x < 10) { x = x + 1; }
}
