//:: cases TC_LI_22_InvariantNestedFunctionCallsSat
//:: tools silicon
//:: verdict Pass

// Invariant contains a nested function call, satisfiable.

requires n > 0;
pure int increment(int n) = n + 1;

requires x > 1;
pure boolean isLargeEnough(int x) = x > 1;

requires x > 0;
void foo(int x) {
    loop_invariant x > 0;
    loop_invariant isLargeEnough(increment(x));
    while (x < 100) { x = x + 1; }
}
