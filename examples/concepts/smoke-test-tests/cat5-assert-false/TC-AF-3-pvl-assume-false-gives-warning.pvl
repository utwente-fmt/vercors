//:: cases TC_AF_3_PvlAssumeFalseGivesWarning
//:: tools silicon
//:: verdict Fail

// TC-AF-3 (PVL): assume false triggers a DeadBranch warning at rewrite time
// (unlike assert false, there is no block cutoff — code after it is still
// instrumented, but here only a plain assignment follows).
// Expected errors: 1 (deadBranch warning for assume false).
void f(int x) {
    x = x + 1;
    assume false;        // DeadBranch warning emitted
    x = x + 2;          // assignment — no Refute check placed
}
