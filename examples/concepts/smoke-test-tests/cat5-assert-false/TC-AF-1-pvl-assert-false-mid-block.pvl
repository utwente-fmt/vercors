//:: cases TC_AF_1_PvlAssertFalseMidBlock
//:: tools silicon
//:: verdict Fail

// assert false on a live path cuts off instrumentation for the rest of the block.
void f(int x) {
    if (x < 0) {                  // live: x is unconstrained, x < 0 is satisfiable
        assert false;              // assertFailed — block cutoff starts here
        if (x == -2) {             // not instrumented (block cutoff)
            x = x - 1;
        }
        loop_invariant x < 0;
        while (x < -1) {           // not instrumented (block cutoff)
            x = x + 1;
        }
        x = x + 2;
    }
}
