// foo's precondition n > 0 is compatible with its postcondition isPos(n) (n > 0),
// so postSat is satisfiable and normal verification passes too.

pure boolean isPos(int n) = n > 0;

requires n > 0;
ensures isPos(n);
void foo(int n) { }
