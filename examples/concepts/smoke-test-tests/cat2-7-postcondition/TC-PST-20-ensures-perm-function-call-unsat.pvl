//:: cases TC_PST_20_EnsuresPermFunctionCallUnsat
//:: tools silicon
//:: verdict Fail

// Same as TC-PST-19 but the called function is always false.

class TC_PST_20_Node {
    int value;
}

requires Perm(n.value, read);
pure boolean isFieldFalse(TC_PST_20_Node n) = n.value > 0 && n.value < 0;


ensures Perm(n.value, read) ** isFieldFalse(n);
void foo(TC_PST_20_Node n) { }
