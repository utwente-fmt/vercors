//:: cases TC_PST_24_InstanceFunctionCallSat
//:: tools silicon
//:: verdict Pass

// Same as TC-PST-19 but the function call is an instance method.

class TC_PST_24_Container {
    int value;

    requires Perm(value, read);
    pure boolean isPositive() = value > 0;
}

requires Perm(c.value, read) ** c.value > 0;
ensures Perm(c.value, read) ** c.isPositive();
void foo(TC_PST_24_Container c) { }
