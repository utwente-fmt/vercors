//:: cases TC_PST_30_OldHeapInEnsuresForallPass
//:: tools silicon
//:: verdict Pass

// \old on a heap-array element inside a \forall, unlike \old on a value param.
context ar != null;
context (\forall* int i; 0 <= i && i < ar.length; Perm(ar[i], write));
requires ar.length > 0;
ensures (\forall int i; 0 <= i && i < ar.length - 1; ar[i] == \old(ar[i]));
ensures ar[ar.length - 1] == 42;
void setLast(int[] ar) {
    ar[ar.length - 1] = 42;
}
