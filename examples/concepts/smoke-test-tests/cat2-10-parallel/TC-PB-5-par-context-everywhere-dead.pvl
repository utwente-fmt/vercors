//:: cases TC_PB_5_ParContextEverywhereDead
//:: tools silicon
//:: verdict Fail

// TC-PB-5: context_everywhere n > 100 is inhaled for every iteration.
// Branch n < 0 inside the body is dead — it contradicts n > 100.
requires n > 100;
void f(int n) {
    par (int tid = 0 .. n)
        context_everywhere n > 100;
    {
        if (n < 0) {
            assert false; // dead: context_everywhere guarantees n > 100
        }
    }
}
