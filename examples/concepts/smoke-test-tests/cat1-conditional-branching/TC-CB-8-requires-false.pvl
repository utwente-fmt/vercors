// Contradiction rather than literal `false` so FilterSpecIgnore doesn't drop
// the method first. Expected: 2x deadBranch + checkSat on the precondition.
requires x > 0 && x < 0;
void f(int x) {
    if (x > 0) {
       x = x + 1; // dead: precondition is false
    }
    if (x < 0) {
        x = x + 1; // dead: precondition is false
    }
}
