//:: cases TC_CB_7_ExhaleFalse
//:: tools silicon
//:: verdict Fail

// exhale false always fails with an exhale error (false never holds as a resource).
// Unlike assume/inhale false, it does not narrow the state, so the code after it
// is not dead.
void f(int x) {
    exhale false; // exhale failure: false never holds as a resource
    if (x > 0) {
        x = x + 1; // NOT dead from exhale's perspective
    }
}
