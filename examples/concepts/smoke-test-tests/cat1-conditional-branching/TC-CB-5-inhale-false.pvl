//:: cases TC_CB_5_InhaleFalse
//:: tools silicon
//:: verdict Fail

// TC-CB-5: inhale false adds an unsatisfiable resource to the state,
// making it immediately contradictory. All subsequent branches are dead.
void f(int x) {
    inhale false; // state immediately contradictory
    if (x > 0) {
        x = x + 1; // dead: state is infeasible after inhale false
    }
}
