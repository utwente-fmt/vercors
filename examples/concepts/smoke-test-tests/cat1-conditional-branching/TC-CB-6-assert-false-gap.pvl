//:: cases TC_CB_6_AssertFalseGap
//:: tools silicon
//:: verdict Fail

// Unlike assume/inhale false, assert false doesn't narrow the state.
void f(int x) {
    assert false; // assertFailed: state is feasible, so false never holds
    if (x > 0) {
        x = x + 1; // NOT dead: assert false does not narrow the state
    }
}
