//:: cases TC_CB_6_AssertFalseGap
//:: tools silicon
//:: verdict Fail

// assert false is a proof obligation: it fails with assertFailed but does not add
// false to the state, so subsequent code is still considered live.
void f(int x) {
    assert false; // assertFailed: state is feasible, so false never holds
    if (x > 0) {
        x = x + 1; // NOT dead: assert false does not narrow the state
    }
}
