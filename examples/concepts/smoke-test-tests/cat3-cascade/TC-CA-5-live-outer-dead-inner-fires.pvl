//:: cases TC_CA_5_LiveOuterDeadInnerFires
//:: tools silicon
//:: verdict Fail

// A live outer branch does not suppress a dead branch nested inside it.
// Expected errors: 1.
requires x > 0;
void f(int x) {
    if (x > 0) { // live outer — outerBlame does not fire
        if (x < 0) { // dead inner — fires because ancestorFired = false
            x = x + 1;
        }
        x = x - 1;
    }
}
