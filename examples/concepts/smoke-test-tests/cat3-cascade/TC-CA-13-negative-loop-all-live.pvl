//:: cases TC_CA_13_NegativeLoopAllLive
//:: tools silicon
//:: verdict Pass

// Negative: invariant established and maintained, nothing suppressed.
requires x >= 0;
void f(int x) {
    loop_invariant x >= 0;
    while (x < 10) {
        x = x + 1; // maintains x >= 0; loop terminates at x = 10
    }
}
