//:: cases TC_CA_4_SequentialIndependentBothFire
//:: tools silicon
//:: verdict Fail

// TC-CA-4: requires x > 0 makes both x < 0 and x < -5 unreachable. Cascade
// suppression only applies to nested branches, not sequential ones at the
// same level, so both fire independently.
// Expected errors: 2 (one per branch).
requires x > 0;
void f(int x) {
    if (x < 0) { // dead branch 1 — fires (blame1, no ancestor)
        x = x + 1;
    }
    if (x < -5) { // dead branch 2 — fires independently (blame2, no ancestor)
        x = x - 1;
    }
}
