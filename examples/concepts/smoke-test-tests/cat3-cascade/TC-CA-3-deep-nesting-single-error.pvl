//:: cases TC_CA_3_DeepNestingSingleError
//:: tools silicon
//:: verdict Fail

// TC-CA-3: Three levels of dead nesting from a precondition (x > 0 makes
// x < 0 impossible). Only the outermost branch fires deadBranch; the middle
// and innermost branches are suppressed via cascade.
// Expected errors: 1. Middle and inner are suppressed.
requires x > 0;
void f(int x) {
    if (x < 0) { // level 1 — dead, fires (outerBlame)
        if (x < -5) { // level 2 — dead, suppressed by outerBlame
            if (x == -10) { // level 3 — dead, suppressed by middleBlame
                x = x + 1;
            }
        }
    }
}
