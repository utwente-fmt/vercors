// Three levels of dead nesting — only the outermost fires.
// Expected errors: 1.
requires x > 0;
void f(int x) {
    if (x < 0) { // level 1 — dead, fires (outerBlame)
        if (x < -5) { // level 2 — dead, suppressed by outerBlame
            if (x == -10) { // level 3 — dead, suppressed by middleBlame
                x = x + 1;
            }
        }
    }
}
