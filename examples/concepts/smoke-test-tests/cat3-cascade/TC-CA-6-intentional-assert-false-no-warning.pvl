//:: cases TC_CA_6_IntentionalAssertFalseNoWarning
//:: tools silicon
//:: verdict Pass

// TC-CA-6: requires x > 0 makes x < 0 unreachable, but assert false as the
// first statement marks this branch as intentionally dead, suppressing the
// deadBranch warning.
// Expected: Pass — no deadBranch warning, no other errors.
requires x > 0;
void f(int x) {
    if (x < 0) {
        assert false; // intentional — suppresses deadBranch for this branch
        x = 0;        // code after the annotation; no branches to instrument
    }
}
