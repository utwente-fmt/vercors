//:: cases TC_CA_12_BodyDeadFromConditionNotSuppressed
//:: tools silicon
//:: verdict Fail

// Body dead from a condition/invariant clash, not establishment failure — fires normally.
requires x > 0;
void f(int x) {
    loop_invariant x > 0 && x < 0;
    while (x < 0) {  // condition contradicts invariant — body unreachable
        x = x + 1;   // deadBranch fires — correctly reported, not suppressed
    }
}
