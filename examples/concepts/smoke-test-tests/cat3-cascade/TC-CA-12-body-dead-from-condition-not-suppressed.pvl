//:: cases TC_CA_12_BodyDeadFromConditionNotSuppressed
//:: tools silicon
//:: verdict Fail

// TC-CA-12: Loop body is dead from a condition/invariant contradiction
// (invariant x > 0 vs. condition x < 0), not from invariant establishment
// failure — so no suppressor is active and deadBranch fires normally.
// Expected errors: 1 (deadBranch for loop body).
requires x > 0;
void f(int x) {
    loop_invariant x > 0 && x < 0;
    while (x < 0) {  // condition contradicts invariant — body unreachable
        x = x + 1;   // deadBranch fires — correctly reported, not suppressed
    }
}
