//:: cases TC_CA_2_AssumeOuterSuppressesInner
//:: tools silicon
//:: verdict Fail

// Same as TC-CA-1 but via assume.
// Expected errors: 2.
void f(int x) {
    assume false; // post-assume check fires — state immediately contradictory
    if (x > 0) { // outer dead — fires independently
        if (x == 1) { // inner dead — suppressed by outer if blame
            x = x + 1;
        }
        x = x - 1;
    }
}
