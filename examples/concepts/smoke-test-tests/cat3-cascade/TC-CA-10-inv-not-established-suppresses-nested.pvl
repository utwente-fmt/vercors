// Dead loop body suppresses nested branches too, not just itself.
void f(int x) {
    loop_invariant false;
    while (x > 0) {
        if (x > 5) {       // suppressed via cascade
            x = x + 1;
        }
        x = x - 1;         // suppressed via cascade
    }
}
