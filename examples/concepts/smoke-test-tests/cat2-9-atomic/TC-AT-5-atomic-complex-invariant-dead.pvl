//:: cases TC_AT_5_AtomicComplexInvariantDead
//:: tools silicon
//:: verdict Fail

// Same as TC-AT-3 but with a conjunctive invariant.
requires x > 0 && y > 0;
void f(int x, int y) {
    invariant inv (x > 0 && y > 0) {
        atomic (inv) {
            if (x < 0) {
                assert false; // dead: invariant guarantees x > 0
            }
            if (y > 0) {
                assert true; // live: invariant guarantees y > 0
            }
        }
    }
}
