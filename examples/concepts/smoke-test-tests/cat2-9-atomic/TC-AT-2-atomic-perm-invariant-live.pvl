//:: cases TC_AT_2_AtomicPermInvariantLive
//:: tools silicon
//:: verdict Pass

// Negative: single non-nested atomic, must not false-positive.
class TC_AT_2_Cell {
    int f;
}

context Perm(c.f, write);
void test(TC_AT_2_Cell c) {
    invariant inv (Perm(c.f, write)) {
        atomic (inv) {
            c.f = c.f + 1;
        }
    }
}
