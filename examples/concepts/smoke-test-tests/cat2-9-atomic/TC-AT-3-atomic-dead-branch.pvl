//:: cases TC_AT_3_AtomicDeadBranch
//:: tools silicon
//:: verdict Fail

// TC-AT-3: Inside atomic(inv), the invariant (x > 0) is inhaled.
// Branch x < 0 is dead — it contradicts the invariant.
// Branch x > 0 is live — it is guaranteed by the invariant.
requires x > 0;
void f(int x) {
    invariant inv (x > 0) {
        atomic (inv) {
            if (x < 0) {
                return; // dead: invariant x > 0 contradicts x < 0
            }
            if (x > 0) {
                return; // live: invariant guarantees x > 0
            }
        }
    }
}
