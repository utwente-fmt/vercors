//:: cases TC_AT_3_AtomicDeadBranch
//:: tools silicon
//:: verdict Fail

// Branch inside atomic(inv) dead under the inhaled invariant; sibling live.
requires x > 0;
void f(int x) {
    invariant inv (x > 0) {
        atomic (inv) {
            if (x < 0) {
                return; // dead: invariant x > 0 contradicts x < 0
            }
            if (x > 0) {
                return; // live: invariant guarantees x > 0
            }
        }
    }
}
