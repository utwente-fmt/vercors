// A block invariant with a heap permission and a value constraint is
// satisfiable, checking that the satisfiability check correctly handles
// resource-based invariants, not just pure ones.
class TC_BI_3_Cell {
    int val;
}

context Perm(c.val, write) ** c.val >= 0;
void f(TC_BI_3_Cell c) {
    invariant inv (Perm(c.val, write) ** c.val >= 0) {
    }
}
