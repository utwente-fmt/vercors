//:: cases TC_CM_5_AllCombined
//:: tools silicon
//:: verdict Fail

// All constructs combined: precondition, assume, inhale, loop invariant.
requires x > 0;
void f(int x) {
    assume x < 100;
    inhale x != 50;
    loop_invariant x > 0;
    while (x < 10) { x = x + 1; }
    if (x < 0) {
        return; // dead: all constraints together exclude x < 0
    }
}
