//:: cases TC_CM_4_PreconditionLoopInvariant
//:: tools silicon
//:: verdict Fail

// TC-CM-4: Precondition + loop invariant together make a post-loop branch dead.
// After loop: invariant (x > 0) AND exit (x >= 10). Branch x < 0 is impossible.
requires x > 0;
void f(int x) {
    loop_invariant x > 0;
    while (x < 10) { x = x + 1; }
    if (x < 0) {
        return; // dead: precondition and invariant both exclude x < 0
    }
}
