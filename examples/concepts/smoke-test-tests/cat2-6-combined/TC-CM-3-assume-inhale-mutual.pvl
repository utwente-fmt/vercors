//:: cases TC_CM_3_AssumeInhaleMutual
//:: tools silicon
//:: verdict Fail

// assume and inhale contradict each other.
void f(int x) {
    assume x > 10;
    inhale x < 5; // contradicts assume x > 10
    if (x == 7) {
        return; // dead: mutual contradiction between assume and inhale
    }
}
