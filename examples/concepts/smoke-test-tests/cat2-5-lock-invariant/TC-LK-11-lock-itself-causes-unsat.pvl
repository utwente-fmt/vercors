//:: cases TC_LK_11_LockItselfCausesUnsat
//:: tools silicon
//:: verdict Fail

// Invariant satisfiable alone; combined with the precondition at lock time, dead.
lock_invariant Perm(flag, 1\2) ** flag == 2;
class LockCausesUnsat {
    int flag;

    requires committed(this) ** Perm(flag, 1\2) ** flag == 1;
    void method() {
        lock this;   // lockDead fires: state becomes flag==1 ** flag==2 (false)
        unlock this; // unlockDead fires: dead state persists
    }
}
