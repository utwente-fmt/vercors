//:: cases TC_LK_5_LockDeadWithoutInvUnsat
//:: tools silicon
//:: verdict Fail

// lockDead fires from dead context, not an unsatisfiable invariant (contrast TC-LK-2).
lock_invariant Perm(val, write) ** val > 0;
class LiveInvDeadContext {
    int val;
    int flag;

    requires committed(this) ** Perm(flag, write) ** flag == 1;
    void method() {
        assume flag == 2; // contradicts flag == 1 — deadBranch fires here
        lock this;        // lockDead fires: state already dead before lock
        unlock this;      // unlockDead fires: dead state persists
    }
}
