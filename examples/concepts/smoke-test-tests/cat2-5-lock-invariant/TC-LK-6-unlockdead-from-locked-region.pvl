//:: cases TC_LK_6_UnlockDeadFromLockedRegion
//:: tools silicon
//:: verdict Fail

// unlockDead fires from dead code introduced inside the locked region.
lock_invariant Perm(val, write) ** val > 0;
class DeadInsideLockedRegion {
    int val;

    requires committed(this);
    void method() {
        lock this;
        assume val < 0; // contradicts val > 0 — deadBranch fires here
        unlock this;    // unlockDead fires: dead state persists
    }
}
