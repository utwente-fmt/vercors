// Unsatisfiable invariant is checked once at class level, not once per method.
lock_invariant Perm(val, write) ** val > 5 ** val < 3;
class UnsatInvClass {
    int val;

    requires committed(this);
    void method_a() {
        if (val > 0) { }
    }

    requires committed(this);
    void method_b() {
        if (val < 10) { }
    }
}
