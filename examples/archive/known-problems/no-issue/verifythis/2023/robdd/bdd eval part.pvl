enum TYPE {
    LEAF, COMPOUND
}

pure boolean nn(Node node) {
    return node != null &&
        ((node.t == TYPE.COMPOUND) ?
            (node != null && nn(node.low) && nn(node.high))
            :
            (node.t == TYPE.LEAF))
            ;
}


class Node {
    final int ID;
    final TYPE t;

    final boolean val;

    final int var;
    final Node low;
    final Node high;

    ensures t == TYPE.LEAF;
    ensures this.val == val;
    constructor(boolean val);

    requires nn(low) && nn(high);
    ensures t == TYPE.COMPOUND;
    ensures this.var == var;
    ensures this.low == low;
    ensures this.high == high;
    constructor(int var, Node low, Node high);

    pure boolean isTrue() {
        return t == TYPE.LEAF && this.val;
    }

    pure boolean isFalse() {
        return t == TYPE.LEAF && !this.val;
    }
}


class BDD {
    ensures nn(\result) && \result.val == b;
    // (\forall set<int> s; b == eval(s, \result));
    ensures \result.t == TYPE.LEAF;
    Node node(boolean b) {
        return new Node(b);
    }

    requires nn(low) && nn(high);
    ensures nn(\result);
    ensures \result.t == TYPE.COMPOUND && 
        \result.low == low &&
        \result.high == high &&
        \result.var == var;
    Node node(int var, Node low, Node high) {
        return new Node(var, low, high);
    }

    requires nn(n);
    pure boolean eval(Node n, set<int> s) {
        if (n.t == TYPE.COMPOUND) {
            if (n.var in s) {
                assert nn(n.high);
                return eval(n.high, s);
            } else {
                assert nn(n.low);
                return eval(n.low, s);
            }
        } else {
            return n.val;
        }
    }

    requires nn(n);
    pure boolean ordered(Node n) {
        if (n.t == TYPE.COMPOUND) {
            return ordered(n.low) && ordered(n.high) &&
                (n.low.t == TYPE.COMPOUND ==> n.var < n.low.var) &&
                (n.high.t == TYPE.COMPOUND ==> n.var < n.high.var);
        } else {
            return true;
        }
    }
    
    requires nn(node) && ordered(node);
    ensures nn(\result);
    ensures (\forall set<int> s; eval(node, s) == !eval(\result, s));
    // TODO
    // ensures ordered(\result);
    Node not(Node node) {
        if (node.isTrue()) {
            return node(false);
        }

        if (node.isFalse()) {
            return node(true);
        }

        return node(node.var, not(node.low), not(node.high));
    }


    /*
        requires \result == node(true) ==> node1 == node(true) && node2 == node(true);
        requires \result == node(false) ==> !(node1 == node(true) && node2 == node(true));
    */
