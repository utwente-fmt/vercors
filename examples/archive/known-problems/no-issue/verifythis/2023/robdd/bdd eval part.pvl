    //     if (node1.isTrue())
    //     return node2;
    //     if (node2.isTrue())
    //     return node1;
    //     if (node1.isFalse() || node2.isFalse())
    //     return node(false);
    //     CompoundNode u = (CompoundNode)node1, v = (CompoundNode)node2;
    //     if (u.var < v.var)
    //     return node(u.var, and(u.low, v), and(u.high, v));
