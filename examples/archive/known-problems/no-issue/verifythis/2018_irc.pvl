/** VerifyThis 2018
    Register Allocation 
*/

pure boolean irreflexive(map<int, set<int>> R) = (∀int x; x in R; !(x in R[x]));
pure boolean closed(map<int, set<int>> R) = (∀int x; x in R; R[x] <= R.keys);
pure boolean symmetric(map<int, set<int>> R) = (∀int x, int y; x in R && y in R[x]; y in R && x in R[y]);

class Irc {

  final int N;
  final int K;
  final int SPILL;

  pure boolean var(int v) = v in {0 .. N};
  pure boolean reg(int r) = r in {0 .. K};
  pure boolean alloc(int a) = a == SPILL || reg(a);

  pure boolean defs() = N > 0 && K > 0 && SPILL == -1;
  
  requires Perm(G, 1\2);
  pure boolean assmsG() = 
    (∀int v; v in G; var(v)) &&
    (∀int v, int u; v in G && u in G[v]; var(u)) &&
    irreflexive(G) && closed(G) && symmetric(G);

  requires Perm(A, 1\2);
  pure boolean assmsA() = 
    (∀int v; v in A; var(v) && alloc(A[v]));

  map<int, set<int>> G;
  map<int, int> A;

  requires Perm(G, 1);
  ensures Perm(G, 1);
  ensures G.keys == \old(G.keys) - { v };
  ensures (∀int w; w in G; {: G[w] :} == \old(G[w] - { v }));
  void remove(int v) {
    G = G.remove(v);
    set<int> keys = G.keys;
    loop_invariant Perm(G, 1);
    loop_invariant !(v in G);
    loop_invariant G.keys == \old(G.keys) - {v};
    loop_invariant keys <= G.keys;
    loop_invariant (∀int u; u in \old(G) && !(u in keys) && u != v; G[u] == \old(G[u] - {v}));
    loop_invariant (∀int u; u in \old(G) && u in keys && u != v; G[u] == \old(G[u]));
    while (|keys| > 0) {
      int u = \choose(keys);
      keys = keys - {u};
      G = G.add(u, G[u] - {v});
      assert (∀int u; u in \old(G) && !(u in keys) && u != v; G[u] == \old(G[u] - {v}));
    }
  }


  requires Perm(G, 1);
  requires u != v;
  ensures Perm(G, 1);
  ensures G.keys == \old(G.keys);
  ensures (∀int w; w in \old(G) && !(u in \old(G[w])); G[w]==\old(G[w]));
  ensures (∀int w; w in \old(G) && u in \old(G[w]); !(u in G[w]) && v in G[w]);
  ensures (∀int w, int x; w in G && x != u && x != v; x in G[w] == x in \old(G[w]));
  void replace(int u, int v) {
    set<int> keys = G.keys;
    loop_invariant Perm(G, 1);
    loop_invariant keys <= G.keys;
    loop_invariant G.keys == \old(G.keys);
    loop_invariant (∀int w; w in G && w in keys; G[w] == \old(G[w]));
    loop_invariant (∀int w; w in G && !(u in \old(G[w])); G[w]==\old(G[w]));
    loop_invariant (∀int w; !(w in keys) && w in G && u in \old(G[w]); !(u in G[w]) && v in G[w]);
    loop_invariant (∀int w, int x; !(w in keys) && w in G && x != u && x != v; x in G[w] == x in \old(G[w]));
    while (|keys| > 0) {
      int w = \choose(keys);
      keys = keys - {w};
      if (u in G[w]) {
        G = G.add(w, G[w] - {u} + {v});
        assert !(w in keys) && w in G && u in \old(G[w]) && !(u in G[w]) && v in G[w];
        assert (∀int w; !(w in keys) && w in G && u in \old(G[w]); !({: u in G[w] :}) && {: v in G[w] :});
        assert (∀int w, int x; !(w in keys) && w in G && x != u && x != v; x in G[w] == x in \old(G[w]));
      }
    }
  }

  requires Perm(G, 1);
  requires irreflexive(G);
  requires u in G && v in G && u!=v && !(v in G[u]);
  ensures Perm(G, 1);
  ensures G.keys == \old(G.keys - {v});
  ensures G[u]==\old(G[u]+G[v]);
  ensures (\forall int w; w in G && w!=u && w!=v && v in \old(G[w]); G[w] == \old(G[w]-{v}+{u}));
  ensures (\forall int w; w in G && w!=u && w!=v && !(v in \old(G[w])); G[w] == \old(G[w]));
  void myMerge(int v, int u) {
    replace(v, u);
    assert G[u] == \old(G[u]);
    G = G.add(u, G[u] + G[v]);
    G = G.remove(v);
  }


  pure boolean hasInterferingVar(map<int, int> A, int reg) = (∃int v; v in A; A[v] == reg);

  requires Perm(A, 1\2);
  requires S <= A.keys;
  requires SPILL == -1;
  requires (∀int k; k in A.keys; k >= 0);
  ensures Perm(A, 1\2) ** A == \old(A);
  ensures \result != SPILL ==> \result in {0..K} && (∀int i; i in S; A[i] != \result);
  ensures \result == SPILL ==> (∀int reg = 0 .. K; hasInterferingVar(A, reg));
  int available(set<int> S) {
    loop_invariant Perm(A, 1\4);
    loop_invariant S <= A.keys;
    loop_invariant (∀int k; k in A.keys; k >= 0);
    loop_invariant (∀int j = 0 .. i; hasInterferingVar(A, j));
    for (int i = 0 .. K) {
      set<int> remainingVars = S;
      int usedVar = -1;
      loop_invariant Perm(A, 1\8);
      loop_invariant (∀int k; k in A.keys; k >= 0);
      loop_invariant S <= A.keys;
      loop_invariant remainingVars <= S;
      loop_invariant usedVar != -1 ==> (usedVar in S && A[usedVar] == i);
      loop_invariant usedVar == -1 ==> (∀int j; j in S && !(j in remainingVars); A[j] != i);
      while (|remainingVars| > 0) {
        int var = \choose(remainingVars);
        remainingVars = remainingVars - {var};

        if (A[var] == i) {
          usedVar = var;
        }
      }
      
      if (usedVar == -1) {
        return i;
      }
    }

    return SPILL;
  }

  requires Perm(G, 1\2) ** Perm(A, 1\2);
  ensures \result == None ==> (∀int v; v in G; v in A);
  ensures \result != None ==> (\result.get in G && !(\result.get in A));
  pure option<int> pick();

  requires Perm(G, 1\2);
  ensures \result == None ==> (∀int u; u != v && u in G; v in G[u]);
  ensures \result != None ==> \result.get != v && \result.get in G && !(v in G[\result.get]);
  pure option<int> coalesce(int v);

  requires Perm(G, 1\2);
  requires var(u) && var(v);
  pure boolean interfere(int u, int v) = v in G && u in G && u in G[v] && v in G[u];
  
  requires Perm(A, 1\2);
  pure option<int> assignment(int v) = v in A ? Some(A[v]) : None;

  context Perm(G, 1) ** Perm(A, 1);
  requires defs() && assmsG() && assmsA();
  ensures assmsG() && assmsA();
  requires A.keys <= G.keys;
  requires (∀int u, int v; var(u) && var(v) && interfere(u, v); assignment(u) != assignment(v));
  ensures A.keys >= \old(A.keys);
  void IRCLite() {
    option<int> vOpt = pick();
    if (vOpt == None) {
      return;
    }
    int v = vOpt.get;
    set<int> S = G[v];
    label beforeRemove;
    remove(v);
    assert 
      (∀int u, int w;
        var(u) && var(w) && u != v && w != v && \old[beforeRemove](interfere(u, w));
        {: interfere(u, w) :});
    IRCLite();
    A = A.add(v, available(S));
  }

}
