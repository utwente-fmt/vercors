{
  "problemMatcher": [
    {
      "owner": "wiki-proselint",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^([^:\\n]+):(\\d+):(\\d+):\\s+([^:]+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
