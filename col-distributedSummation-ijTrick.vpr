    var return: Void
    var flatten: Ref
    var flatten1: Int
    exc := null
    flatten := this
    flatten1 := this.n
    flatten.frontN := flatten1
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaGetTotalHead(tid1: Int, nodes: Seq[Ref], i: Int, rounds: Int)
  returns (res: Void)
  requires nn(nodes)
  requires 0 <= i
  requires i < |nodes|
  requires 1 <= rounds
  requires rounds <= |nodes|
  ensures nn(nodes)
  ensures getTotal(nodes, i, rounds) ==
    getTotal(nodes, next(i, |nodes|), rounds - 1) + v(nodes[i])
{
  {
    var exc: Ref
    var return: Void
    exc := null
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaGetTotalLast(tid1: Int, nodes: Seq[Ref], i: Int, rounds: Int)
  returns (res: Void)
  requires nn(nodes)
  requires 0 <= i
  requires i < |nodes|
  requires 1 <= rounds
  requires rounds <= |nodes|
  ensures nn(nodes)
  ensures getTotal(nodes, i, rounds) ==
    getTotal(nodes, i, rounds - 1) + v(nodes[mod(i - rounds, |nodes|)])
{
  {
    var exc: Ref
    var return: Void
    var res1: Void
    exc := null
    inhale false
    if (rounds == 1) {
      assert getTotal(nodes, i, rounds) ==
        v(nodes[i]) + getTotal(nodes, next(i, |nodes|), rounds - 1)
    } else {
      res1 := lemmaGetTotalLast(tid1, nodes, next(i, |nodes|), rounds - 1)
      assert getTotal(nodes, next(i, |nodes|), rounds - 1) ==
        getTotal(nodes, next(i, |nodes|), rounds - 1 - 1) +
        v(nodes[mod(next(i, |nodes|) - rounds - 1, |nodes|)])
    }
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaTotalAB(tid1: Int, nodes: Seq[Ref], a: Int, b: Int, p: Frac)
  returns (res: Void)
  requires 0 * write < frac_val(p)
  requires frac_val(p) < write
  requires 2 < |nodes|
  requires 0 <= a
  requires a < |nodes|
  requires 0 <= b
  requires b < |nodes|
  requires nn(nodes)
  requires (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> acc(nodes[i].total, frac_val(p)))
  requires nodes[a].total == getTotal(nodes, a, |nodes| - 1)
  requires nodes[b].total == getTotal(nodes, b, |nodes| - 1)
  requires mod(a + 1, |nodes|) == b
  ensures 0 * write < frac_val(p)
  ensures frac_val(p) < write
  ensures 2 < |nodes|
  ensures 0 <= a
  ensures a < |nodes|
  ensures 0 <= b
  ensures b < |nodes|
  ensures nn(nodes)
  ensures (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> acc(nodes[i].total, frac_val(p)))
  ensures nodes[a].total == nodes[b].total
{
  {
    var exc: Ref
    var return: Void
    var res1: Void
    var res2: Void
    exc := null
    assert nodes[a].total == getTotal(nodes, a, |nodes| - 1)
    assert nodes[a].total ==
      getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1) + v(nodes[a])
    res1 := lemmaGetTotalLast(tid1, nodes, next(a, |nodes|), |nodes| - 1 -
      1)
    assert nodes[a].total ==
      getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1 - 1) + v(nodes[b]) +
      v(nodes[a])
    assert nodes[b].total == getTotal(nodes, b, |nodes| - 1)
    res2 := lemmaGetTotalHead(tid1, nodes, next(b, |nodes|), |nodes| - 1 -
      1)
    assert nodes[b].total ==
      getTotal(nodes, next(next(b, |nodes|), |nodes|), |nodes| - 1 - 1 - 1) +
      v(nodes[a]) +
      v(nodes[b])
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaTotalShiftRight1(tid1: Int, nodes: Seq[Ref], a: Int)
  returns (res: Void)
  requires 2 < |nodes|
  requires nn(nodes)
  requires 0 <= a
  requires a < |nodes| - 1
  ensures 2 < |nodes|
  ensures nn(nodes)
  ensures 0 <= a
  ensures a < |nodes| - 1
  ensures getTotal(nodes, a, |nodes| - 1) ==
    getTotal(nodes, a + 1, |nodes| - 1)
{
  {
    var exc: Ref
    var return: Void
    var b: Int
    var flatten: Int
    var res1: Void
    exc := null
    flatten := a + 1
    b := flatten
    assert getTotal(nodes, a, |nodes| - 1) ==
      getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1) + v(nodes[a])
    res1 := lemmaGetTotalLast(tid1, nodes, next(a, |nodes|), |nodes| - 1 -
      1)
    assert getTotal(nodes, a, |nodes| - 1) ==
      getTotal(nodes, next(a, |nodes|), |nodes| - 1 - 1 - 1) + v(nodes[b]) +
      v(nodes[a])
    assert getTotal(nodes, b, |nodes| - 1) ==
      getTotal(nodes, next(b, |nodes|), |nodes| - 1 - 1) + v(nodes[b])
    assert a == next(b, |nodes|)
    assert getTotal(nodes, b, |nodes| - 1) ==
      getTotal(nodes, a, |nodes| - 1)
    assert getTotal(nodes, a, |nodes| - 1) ==
      getTotal(nodes, b, |nodes| - 1)
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaTotalShiftRight(tid1: Int, nodes: Seq[Ref], a: Int, b: Int)
  returns (res: Void)
  requires 2 < |nodes|
  requires nn(nodes)
  requires 0 <= a
  requires a < |nodes|
  requires 0 <= b
  requires b < |nodes|
  requires a < b
  ensures 2 < |nodes|
  ensures nn(nodes)
  ensures 0 <= a
  ensures a < |nodes|
  ensures 0 <= b
  ensures b < |nodes|
  ensures getTotal(nodes, a, |nodes| - 1) ==
    getTotal(nodes, b, |nodes| - 1)
{
  {
    var exc: Ref
    var return: Void
    var i: Int
    var i1: Int
    var flatten: Int
    var res1: Void
    var excbeforeloop: Ref
    exc := null
    inhale false
    label LOOP
    excbeforeloop := exc
    i1 := a
    while (i < b)
      invariant exc == excbeforeloop
      invariant a <= i
      invariant i < b + 1
      invariant getTotal(nodes, a, |nodes| - 1) ==
        getTotal(nodes, i, |nodes| - 1) 
    {
      res1 := lemmaTotalShiftRight1(tid1, nodes, i)
      flatten := i + 1
      i := flatten
    }
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaTotalShift(tid1: Int, nodes: Seq[Ref], a: Int, b: Int)
  returns (res: Void)
  requires nn(nodes)
  requires 0 <= a
  requires a < |nodes|
  requires 0 <= b
  requires b < |nodes|
  ensures nn(nodes)
  ensures 0 <= a
  ensures a < |nodes|
  ensures 0 <= b
  ensures b < |nodes|
  ensures getTotal(nodes, a, |nodes| - 1) ==
    getTotal(nodes, b, |nodes| - 1)
{
  {
    var exc: Ref
    var return: Void
    var res1: Void
    var res2: Void
    exc := null
    if (a == b) {
    } elseif (|nodes| < 2) {
    } elseif (|nodes| == 2) {
      assert getTotal(nodes, a, |nodes| - 1) ==
        v(nodes[a]) + getTotal(nodes, next(a, |nodes|), |nodes| - 2)
      assert getTotal(nodes, b, |nodes| - 1) ==
        v(nodes[b]) + getTotal(nodes, next(b, |nodes|), |nodes| - 2)
    } elseif (a < b) {
      res1 := lemmaTotalShiftRight(tid1, nodes, a, b)
    } else {
      res2 := lemmaTotalShiftRight(tid1, nodes, b, a)}
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaTotal2(tid1: Int, nodes: Seq[Ref], p: Frac) returns (res: Void)
  requires 0 * write < frac_val(p)
  requires frac_val(p) < write
  requires nn(nodes)
  requires (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> acc(nodes[i].total, frac_val(p)))
  requires (forall i: Int ::
      { nodes[i].total }
      0 <= i && i < |nodes| ==>
      nodes[i].total == getTotal(nodes, i, |nodes| - 1))
  requires |nodes| == 2
  ensures 0 * write < frac_val(p)
  ensures frac_val(p) < write
  ensures nn(nodes)
  ensures (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> acc(nodes[i].total, frac_val(p)))
  ensures (forall i: Int ::
      { nodes[i].total }
      0 <= i && i < |nodes| ==>
      nodes[i].total == getTotal(nodes, i, |nodes| - 1))
  ensures (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> nodes[0].total == nodes[i].total)
{
  {
    var exc: Ref
    var return: Void
    exc := null
    assert nodes[0].total ==
      v(nodes[0]) + getTotal(nodes, 1, |nodes| - 1 - 1)
    assert nodes[0].total == v(nodes[0]) + v(nodes[1])
    assert nodes[1].total ==
      v(nodes[1]) + getTotal(nodes, 0, |nodes| - 1 - 1)
    assert nodes[1].total == v(nodes[1]) + v(nodes[0])
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

method lemmaTotal(tid1: Int, nodes: Seq[Ref], p: Frac) returns (res: Void)
  requires nn(nodes)
  requires (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> acc(nodes[i].total, frac_val(p)))
  requires (forall i: Int ::
      { nodes[i].total }
      0 <= i && i < |nodes| ==>
      nodes[i].total == getTotal(nodes, i, |nodes| - 1))
  requires 0 * write < frac_val(p)
  requires frac_val(p) < write
  ensures nn(nodes)
  ensures (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> acc(nodes[i].total, frac_val(p)))
  ensures (forall i: Int ::
      { nodes[i].total }
      0 <= i && i < |nodes| ==>
      nodes[i].total == getTotal(nodes, i, |nodes| - 1))
  ensures 0 * write < frac_val(p)
  ensures frac_val(p) < write
  ensures (forall i: Int ::
      { nodes[i] }
      0 <= i && i < |nodes| ==> nodes[0].total == nodes[i].total)
{
  {
    var exc: Ref
    var return: Void
    var i: Int
    var i1: Int
    var res1: Void
    var flatten: Int
    var flatten1: Int
    var res2: Void
    var excbeforeloop: Ref
    exc := null
    inhale false
    if (|nodes| < 2) {
    } elseif (|nodes| == 2) {
      res1 := lemmaTotal2(tid1, nodes, newFrac(frac_val(p) / 2))
    } else {
      label LOOP
      excbeforeloop := exc
      flatten := 1
      i1 := flatten
      while (i < |nodes|)
        invariant exc == excbeforeloop
        invariant nn(nodes)
        invariant (forall i2: Int ::
            { nodes[i2] }
            0 <= i2 && i2 < |nodes| ==> acc(nodes[i2].total, frac_val(p)))
        invariant (forall i2: Int ::
            { nodes[i2].total }
            0 <= i2 && i2 < |nodes| ==>
            nodes[i2].total == getTotal(nodes, i2, |nodes| - 1))
        invariant 1 <= i
        invariant i < |nodes| + 1
        invariant (forall j: Int ::
            { nodes[j].total }
            0 <= j && j < i ==> nodes[0].total == nodes[j].total) 
      {
        res2 := lemmaTotalAB(tid1, nodes, i - 1, i, newFrac(frac_val(p) / 2))
        flatten1 := i + 1
        i := flatten1
      }
    }
    label END
    res := return
    label BUBBLE
    assert exc == null
  }
}

